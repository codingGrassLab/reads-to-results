---
interface Props { src: string; alt: string; width?: number; height?: number }
import { asset } from "../i18n/ui";
const { alt, width, height } = Astro.props;
const src = Astro.props.src.startsWith("/") ? asset(Astro.props.src) : Astro.props.src;
---
<figure>
  <img src={src} alt={alt} loading="lazy" width={width} height={height} />
  {Astro.slots.has("default") && <figcaption><slot /></figcaption>}
</figure>
