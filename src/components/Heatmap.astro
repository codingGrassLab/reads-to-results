---
import hm from "../data/heatmap.json";
import type { Lang } from "../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const txt = { en: { z: "z-score of the VST value, per gene", trt: "dex", untrt: "untreated", hi: "higher than the gene's mean", lo: "lower" } }[lang];
---
<figure>
  <div class="plot" data-plot="heat"><script type="application/json" set:html={JSON.stringify({ ...hm, txt })} />
    <div class="legend"><span><i style="background:#2c5fa8"></i>{txt.lo}</span><span><i style="background:#f1f1ef;border:1px solid #c9cec8"></i>0</span><span><i style="background:#c0392b"></i>{txt.hi}</span><span class="muted">{txt.z}</span></div></div>
  <figcaption><slot /></figcaption>
</figure>
<script>
  import { el, tooltip, readData, colors } from "../scripts/plot";
  type D = { genes: string[]; symbols: string[]; samples: string[]; dex: string[]; cell: string[]; z: number[][]; vst: number[][]; txt: Record<string, string> };
  const color = (z: number) => { const t = Math.max(-1, Math.min(1, z / 2.5)); const mix = (a: number[], b: number[], k: number) => a.map((v, i) => Math.round(v + (b[i] - v) * k)); const c = t < 0 ? mix([241, 241, 239], [44, 95, 168], -t) : mix([241, 241, 239], [192, 57, 43], t); return `rgb(${c.join(",")})`; };
  document.querySelectorAll<HTMLElement>('[data-plot="heat"]').forEach((root) => {
    const d = readData<D>(root);
    // order samples: untreated first, then treated; within each by cell line
    const order = d.samples.map((_, i) => i).sort((a, b) => (d.dex[a] === d.dex[b] ? d.cell[a].localeCompare(d.cell[b]) : d.dex[a] === "untrt" ? -1 : 1));
    const cw = 44, rh = 16, left = 92, top = 54, W = left + cw * d.samples.length + 10, H = top + rh * d.genes.length + 8;
    const svg = el("svg", { viewBox: `0 0 ${W} ${H}`, role: "img", style: "max-width:560px;margin:auto" });
    const tip = tooltip(root);
    order.forEach((j, col) => {
      const cx = left + col * cw;
      svg.appendChild(el("rect", { x: cx + 1, y: 6, width: cw - 2, height: 8, rx: 2, fill: d.dex[j] === "trt" ? colors.trt : colors.untrt }));
      svg.appendChild(el("text", { class: "label", x: cx + cw / 2, y: 28, "text-anchor": "middle", style: "font-size:9px" }, d.cell[j]));
      svg.appendChild(el("text", { class: "label", x: cx + cw / 2, y: 44, "text-anchor": "middle", style: "font-size:9px" }, d.dex[j] === "trt" ? d.txt.trt : d.txt.untrt));
    });
    d.genes.forEach((g, i) => {
      svg.appendChild(el("text", { class: "label", x: left - 6, y: top + i * rh + rh * 0.72, "text-anchor": "end", style: "font-size:10px" }, d.symbols[i]));
      order.forEach((j, col) => {
        const r = el("rect", { x: left + col * cw, y: top + i * rh, width: cw - 1, height: rh - 1, fill: color(d.z[i][j]) });
        r.addEventListener("pointermove", (e) => tip.show(`<b>${d.symbols[i]}</b> · ${d.samples[j]}<br>z ${d.z[i][j].toFixed(2)} · VST ${d.vst[i][j].toFixed(2)}`, e.clientX, e.clientY));
        r.addEventListener("pointerleave", tip.hide);
        svg.appendChild(r);
      });
    });
    root.insertBefore(svg, root.querySelector(".legend"));
  });
</script>
