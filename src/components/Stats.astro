---
// A row of large numbers with captions.
interface Props { items: { value: string | number; label: string }[] }
const { items } = Astro.props;
---
<div class="stats">{items.map((s) => <div class="stat"><b>{typeof s.value === "number" ? s.value.toLocaleString("en-US") : s.value}</b><span>{s.label}</span></div>)}</div>
