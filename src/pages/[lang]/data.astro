---
import Base from "../../layouts/Base.astro";
import { langs, t, path, num, type Lang } from "../../i18n/ui";
import summary from "../../data/summary.json";
import versions from "../../data/versions.json";
import paper from "../../data/paper_check.json";
import samples from "../../data/samples.json";
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;

const files = [
  { f: "airway_samples.csv", en: "The eight samples: cell line, treatment, SRA run.", bn: "আটটা sample: cell line, treatment, SRA run।" },
  { f: "airway_counts.csv.gz", en: `Raw count matrix, ${summary.genes_in_matrix.toLocaleString()} genes × 8 samples, exactly as in the airway package.`, bn: `Raw count matrix, ${num(lang, summary.genes_in_matrix)} gene × ৮ sample, airway package-এ যেমন আছে ঠিক তেমন।` },
  { f: "airway_deseq2_results.csv", en: "Full DESeq2 results for dex vs untreated, with gene symbols and apeglm-shrunken fold changes.", bn: "dex বনাম untreated-এর পূর্ণ DESeq2 ফলাফল, gene symbol আর apeglm-shrunken fold change সহ।" },
  { f: "airway_go_bp.csv", en: "GO biological-process enrichment (clusterProfiler) of the genes with padj < 0.05 and |log2FC| > 1.", bn: "padj < 0.05 আর |log2FC| > 1 gene-গুলোর GO biological-process enrichment (clusterProfiler)।" },
  { f: "sessionInfo.txt", en: "R sessionInfo() of the run that produced everything here.", bn: "যে run থেকে এখানের সবকিছু এসেছে, তার R sessionInfo()।" },
];
const s = {
  en: {
    inputs: "Inputs", inputsText: "The airway Bioconductor package: gene-level read counts for 8 RNA-seq samples of human airway smooth muscle cells (4 cell lines × dexamethasone / untreated), from Himes et al. 2014, GEO GSE52778, SRA SRP033351. The package authors aligned the reads to GRCh37 with STAR and counted with summarizeOverlaps; the differential-expression lessons start from their count matrix. The package also ships complete Salmon 0.14.1 quantifications (GENCODE v29) for two samples, SRR1039508 and SRR1039509; lessons 6 and 7 read every number from those files, and lesson 7 imports them with tximport using a transcript-to-gene table built from the GENCODE v29 GTF (analysis/tx2gene.csv).",
    script: "The script", scriptText: "One R script does everything: it loads the data, runs DESeq2, makes every plot and writes every number the site shows; a second script reads the shipped Salmon output files. Re-running it regenerates the site's data.",
    methods: "Methods in one paragraph",
    methodsText: `Genes with fewer than 10 counts in at least 4 samples were removed (${summary.genes_in_matrix.toLocaleString()} → ${summary.genes_after_filter.toLocaleString()} genes). Differential expression was tested with DESeq2 ${versions.packages.DESeq2} using the design ~ cell + dex, the Wald test and Benjamini–Hochberg adjustment at α = 0.05; DESeq2's independent filtering removed a further ${summary.independent_filtered} genes, leaving ${summary.genes_tested.toLocaleString()} tested. Log2 fold changes were shrunk with apeglm ${versions.packages.apeglm}. PCA and heatmaps use the variance-stabilizing transformation. GO biological-process enrichment used clusterProfiler ${versions.packages.clusterProfiler} with org.Hs.eg.db ${versions.packages["org.Hs.eg.db"]}, the ${summary.genes_tested.toLocaleString()} tested genes as universe, and Benjamini–Hochberg adjustment.`,
    versions: "Versions", check: "Check against the original paper",
    checkText: "Himes et al. (2014) discussed a set of glucocorticoid-responsive genes. All of them come out significant here, in the direction the paper reports. This does not prove the analysis is perfect, but it shows the pipeline recovers the published biology.",
    downloads: "Downloads", colab: "Run it yourself", colabText: "A notebook reproduces lessons 8 to 10 (count matrix → DESeq2 → plots → GO) in Google Colab's R runtime. Installing Bioconductor there takes about ten minutes; the analysis itself takes under a minute.",
    colabBtn: "Open the notebook", colabNote: "The notebook file is in the repository under public/notebooks/. Once the repository is on GitHub, the Colab link is https://colab.research.google.com/github/<user>/<repo>/blob/main/public/notebooks/airway_deseq2.ipynb.",
    gene: "gene", lfc: "log2 fold change", padj: "adjusted p", date: "Analysis run on",
  },
  bn: {
    inputs: "ইনপুট", inputsText: "airway Bioconductor package: মানুষের airway smooth muscle কোষের ৮টা RNA-seq sample-এর gene-level read count (৪টা cell line × dexamethasone / untreated), Himes et al. 2014, GEO GSE52778, SRA SRP033351 থেকে। package-এর লেখকরা read-গুলো STAR দিয়ে GRCh37-এ align করে summarizeOverlaps দিয়ে গুনেছেন; differential-expression লেসনগুলো তাঁদের count matrix থেকে শুরু করে। package-এর সাথে দুটো sample, SRR1039508 আর SRR1039509-এর পূর্ণ Salmon 0.14.1 quantification (GENCODE v29)-ও আসে; লেসন ৬ আর ৭-এর প্রতিটা সংখ্যা ওই ফাইল থেকে পড়া।",
    script: "স্ক্রিপ্ট", scriptText: "একটা R স্ক্রিপ্ট সবকিছু করে: ডেটা লোড করে, DESeq2 চালায়, প্রতিটা প্লট বানায় আর সাইটে দেখানো প্রতিটা সংখ্যা লেখে; দ্বিতীয় একটা স্ক্রিপ্ট package-এর সাথে আসা Salmon আউটপুট ফাইল পড়ে। আবার চালালে সাইটের ডেটা নতুন করে তৈরি হয়।",
    methods: "এক অনুচ্ছেদে পদ্ধতি",
    methodsText: `অন্তত ৪টা sample-এ ১০-এর কম count থাকা gene বাদ দেওয়া হয়েছে (${num(lang, summary.genes_in_matrix)} → ${num(lang, summary.genes_after_filter)} gene)। Differential expression পরীক্ষা করা হয়েছে DESeq2 ${versions.packages.DESeq2} দিয়ে, design ~ cell + dex, Wald test আর Benjamini–Hochberg adjustment, α = 0.05; DESeq2-এর independent filtering আরও ${num(lang, summary.independent_filtered)} gene বাদ দিয়েছে, ${num(lang, summary.genes_tested)} gene পরীক্ষিত হয়েছে। Log2 fold change shrink করা হয়েছে apeglm ${versions.packages.apeglm} দিয়ে। PCA আর heatmap-এ variance-stabilizing transformation ব্যবহার করা হয়েছে। GO biological-process enrichment করা হয়েছে clusterProfiler ${versions.packages.clusterProfiler} আর org.Hs.eg.db ${versions.packages["org.Hs.eg.db"]} দিয়ে, ${num(lang, summary.genes_tested)} tested gene universe হিসেবে, Benjamini–Hochberg adjustment সহ।`,
    versions: "Version", check: "মূল পেপারের সাথে মিলিয়ে দেখা",
    checkText: "Himes et al. (2014) কিছু glucocorticoid-responsive gene নিয়ে আলোচনা করেছিলেন। এখানে সবগুলোই significant এসেছে, পেপার যে দিকে বলেছে সেই দিকেই। এটা analysis নিখুঁত প্রমাণ করে না, কিন্তু দেখায় যে pipeline প্রকাশিত biology-টা ফিরে পায়।",
    downloads: "ডাউনলোড", colab: "নিজে চালান", colabText: "একটা notebook Google Colab-এর R runtime-এ লেসন ৮ থেকে ১০ (count matrix → DESeq2 → প্লট → GO) আবার চালায়। ওখানে Bioconductor ইনস্টল হতে দশ মিনিটের মতো লাগে; analysis নিজে এক মিনিটের কম।",
    colabBtn: "Notebook খুলুন", colabNote: "Notebook ফাইলটা repository-তে public/notebooks/-এর নিচে আছে। Repository GitHub-এ উঠলে Colab লিংক হবে https://colab.research.google.com/github/<user>/<repo>/blob/main/public/notebooks/airway_deseq2.ipynb।",
    gene: "gene", lfc: "log2 fold change", padj: "adjusted p", date: "Analysis চালানো হয়েছে",
  },
}[lang];
---
<Base lang={lang} title={t(lang, "data.title")} description={t(lang, "data.lead")} active="data">
  <div class="container prose">
    <div class="page-head"><h1>{t(lang, "data.title")}</h1><p class="lead">{t(lang, "data.lead")}</p></div>

    <h2>{s.inputs}</h2>
    <p>{s.inputsText}</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Run</th><th>Cell line</th><th>dex</th><th class="num">Read pairs</th><th class="num">Genes with ≥ 1 read</th></tr></thead>
      <tbody>{samples.map((x) => <tr><td><code>{x.run}</code></td><td>{x.cell}</td><td>{x.dex}</td><td class="num">{x.libsize.toLocaleString("en-US")}</td><td class="num">{x.detected.toLocaleString("en-US")}</td></tr>)}</tbody>
    </table></div>

    <h2>{s.script}</h2>
    <p>{s.scriptText} <a href="https://github.com/" rel="nofollow"><code>analysis/run.R</code></a></p>

    <h2>{s.methods}</h2>
    <p>{s.methodsText}</p>

    <h2>{s.versions}</h2>
    <p class="small muted">{s.date} {versions.date}. {versions.r}, Bioconductor {versions.bioc}.</p>
    <div class="table-wrap"><table>
      <tbody>{Object.entries(versions.packages).map(([k, v]) => <tr><td><code>{k}</code></td><td class="num">{v}</td></tr>)}</tbody>
    </table></div>

    <h2>How the tools are checked</h2>
    <ul>
      <li><strong>Explore your results:</strong> up/down counts at several thresholds compared with R on DESeq2 (airway), edgeR, limma-voom and a simulated dataset; decimal-comma and tab-separated files.</li>
      <li><strong>Script generator:</strong> the generated script is run in R on the airway count matrix and must reproduce this site's numbers (<code>npm run test:script</code>); also run on a simulated dataset with non-Ensembl IDs.</li>
      <li><strong>Hub genes:</strong> Degree, Betweenness, Closeness, Radiality, EcCentricity, ClusteringCoefficient, MCC, MNC and DMNC are compared with networkx on random graphs, and Stress with brute-force shortest-path counting (<code>npm run test:hub</code>). EPC and BottleNeck follow cytoHubba's definitions (EPC with 1,000 random percolations).</li>
      <li><strong>Dataset tool:</strong> run counts, layouts, file sizes and MD5s compared with independent ENA queries for six studies.</li>
      <li><strong>Enrichment:</strong> computed by g:Profiler; this site only filters and draws its output.</li>
    </ul>

    <h2>{s.check}</h2>
    <p>{s.checkText}</p>
    <div class="table-wrap"><table>
      <thead><tr><th>{s.gene}</th><th>Ensembl</th><th class="num">baseMean</th><th class="num">{s.lfc}</th><th class="num">{s.padj}</th></tr></thead>
      <tbody>{paper.map((g) => <tr><td><b>{g.symbol}</b></td><td><code>{g.gene_id}</code></td><td class="num">{Math.round(g.baseMean).toLocaleString("en-US")}</td><td class="num" style={`color:${g.log2FoldChange > 0 ? "var(--up)" : "var(--down)"}`}>{g.log2FoldChange > 0 ? "+" : ""}{g.log2FoldChange.toFixed(2)}</td><td class="num">{g.padj.toExponential(1)}</td></tr>)}</tbody>
    </table></div>

    <h2>{s.downloads}</h2>
    <ul class="files">
      {files.map((f) => <li><div><code>{f.f}</code><span class="d">{f[lang]}</span></div><a class="btn btn-ghost" href={`/data/${f.f}`} download>{t(lang, "common.download")}</a></li>)}
    </ul>

    <h2>{s.colab}</h2>
    <p>{s.colabText}</p>
    <p><a class="btn btn-ghost" href="/notebooks/airway_deseq2.ipynb" download>{t(lang, "common.download")} · airway_deseq2.ipynb</a></p>
    <p class="small muted">{s.colabNote}</p>
  </div>
</Base>
