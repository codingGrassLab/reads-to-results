---
import Base from "../../layouts/Base.astro";
import HeroVolcano from "../../components/HeroVolcano.astro";
import { langs, t, path, asset, type Lang } from "../../i18n/ui";
import { lessons, split } from "../../lib/lessons";
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const learn = await lessons("learn", lang);
const read = await lessons("read", lang);
---
<Base lang={lang} active="home">
  <div class="container">
    <section class="hero">
      <div>
        <div class="eyebrow">{t(lang, "home.eyebrow")}</div>
        <h1>{t(lang, "home.title")}</h1>
        <p class="lead">{t(lang, "home.lead")}</p>
        <div class="actions">
          <a class="btn btn-primary" href={learn[0] ? path(lang, "learn", split(learn[0].id).slug) : path(lang, "learn")}>{t(lang, "home.ctaStart")}</a>
          <a class="btn btn-ghost" href={path(lang, "read")}>{t(lang, "home.ctaRead")}</a>
        </div>
      </div>
      <HeroVolcano />
    </section>

    <section class="section">
      <div class="section-head"><h2>Learn by breaking it</h2><p>Most tutorials show the commands that work. These show what goes wrong, on the same real data, with the real numbers.</p></div>
      <div class="grid two-cards">
        <a class="card" href={path(lang, "break")}>
          <span class="n">try it</span>
          <h3>Break it yourself</h3>
          <p>Ignore the donor, lose a sample, keep two donors, swap one label: switch it on and watch 4,081 significant genes shrink, sometimes to almost none.</p>
        </a>
        <a class="card" href={path(lang, "mistakes")}>
          <span class="n">read it</span>
          <h3>Ten mistakes</h3>
          <p>Confounded batches, normalized input, p instead of adjusted p, the wrong enrichment background, Excel dates: each one made on purpose, with what it did.</p>
        </a>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>{t(lang, "home.learnTitle")}</h2><p>{t(lang, "home.learnLead")}</p></div>
      <ol class="path">
        {learn.map((e, i) => (
          <li>
            <a href={path(lang, "learn", split(e.id).slug)}>
              <span class="n">{String(i + 1).padStart(2, "0")}</span>
              <span class="t"><b>{e.data.title}</b>{e.data.description && <small>{e.data.description}</small>}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="section">
      <div class="section-head"><h2>{t(lang, "home.readTitle")}</h2><p>{t(lang, "home.readLead")}</p></div>
      <div class="grid">
        {read.map((e) => (
          <a class="card" href={path(lang, "read", split(e.id).slug)}>
            <h3>{e.data.title}</h3>
            {e.data.description && <p>{e.data.description}</p>}
          </a>
        ))}
      </div>
    </section>

    <section class="section two-col">
      <div>
        <h2>{t(lang, "home.dataTitle")}</h2>
        <p>{t(lang, "home.dataLead")}</p>
      </div>
      <div class="note">
        <h3>{t(lang, "home.honest")}</h3>
        <p>{t(lang, "home.honestText")}</p>
      </div>
    </section>
  </div>

  <style>
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 2.5rem; }
    @media (max-width: 900px) { .hero { grid-template-columns: 1fr; } }
    .path { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; counter-reset: none; }
    .path a { display: flex; gap: 1rem; align-items: baseline; padding: 0.8rem 1rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); text-decoration: none; color: var(--text); transition: border-color 0.15s, transform 0.15s; }
    .path a:hover { border-color: var(--accent); transform: translateX(3px); }
    .path .n { font-family: var(--f-mono); font-size: 0.85rem; color: var(--accent); flex: none; width: 2rem; }
    .path .t { display: flex; flex-direction: column; gap: 0.15rem; }
    .path .t b { color: var(--ink); font-weight: 600; }
    .path .t small { color: var(--muted); font-size: 0.88rem; }
    .two-cards { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
    .two-col { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; align-items: start; }
    @media (max-width: 860px) { .two-col { grid-template-columns: 1fr; } }
    .two-col h2 { margin-top: 0; }
    .note h3 { margin-top: 0; }
  </style>
</Base>
