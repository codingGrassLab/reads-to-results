---
import Base from "../../layouts/Base.astro";
import { langs, path, type Lang } from "../../i18n/ui";
import { organisms, sourceNames } from "../../scripts/enrich";
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const title = "Enrichment";
const description = "Which pathways and GO terms are over-represented among your differentially expressed genes? Up- and down-regulated lists tested separately, against the genes you actually tested as background, through the g:Profiler service.";
const defaultSources = ["GO:BP", "KEGG", "REAC", "WP"];
---
<Base lang={lang} title={title} description={description} active="enrich">
  <div class="container">
    <div class="page-head prose">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <p class="small muted"><strong>What leaves your browser:</strong> the gene identifiers you submit (and the background list) are sent to the public g:Profiler API at the University of Tartu when you press Run. No expression values, no file names. Do not submit gene lists you are not allowed to share. A KEGG "pathway map" link converts that term’s genes to Entrez IDs (g:Convert) and opens the map on kegg.jp with those IDs in the address; the map itself is KEGG’s and is shown on their site.</p>
    </div>

    <div class="en">
      <form class="en-form" data-form>
        <fieldset>
          <legend>Gene lists</legend>
          <p class="small muted" data-handoff></p>
          <label>Up-regulated genes (one per line; Ensembl IDs or symbols)<textarea name="up" rows="5" placeholder="ENSG00000103196&#10;ENSG00000096060&#10;…"></textarea></label>
          <label>Down-regulated genes<textarea name="down" rows="5" placeholder="leave empty to test one list only"></textarea></label>
          <label>Background: all genes tested for differential expression (recommended; empty = all annotated genes)<textarea name="background" rows="3" placeholder="one gene per line"></textarea></label>
          <button type="button" class="btn btn-ghost" data-example>Load the airway example</button>
        </fieldset>
        <fieldset>
          <legend>Settings</legend>
          <label>Organism <select name="organism">{organisms.map(([v, n]) => <option value={v}>{n}</option>)}</select></label>
          <div class="en-sources">{Object.entries(sourceNames).map(([k, n]) => <label class="chk"><input type="checkbox" name="src" value={k} checked={defaultSources.includes(k)} /> {n}</label>)}</div>
          <label>Multiple-testing method <select name="method"><option value="fdr">Benjamini–Hochberg FDR (as in clusterProfiler, DAVID, ShinyGO)</option><option value="g_SCS">g:SCS (g:Profiler's own, stricter: accounts for term overlap)</option><option value="bonferroni">Bonferroni (strictest)</option></select></label>
          <label>Significance threshold <input type="number" name="threshold" value="0.05" step="any" min="0" max="1" /></label>
          <label>Term size: from <input type="number" name="minSize" value="10" min="1" style="width:5rem;display:inline-block" /> to <input type="number" name="maxSize" value="1000" min="1" style="width:6rem;display:inline-block" /> genes (filters the table and plot)</label>
          <label class="chk"><input type="checkbox" name="noIEA" /> exclude electronic GO annotations (IEA)</label>
        </fieldset>
        <fieldset>
          <legend>Figure</legend>
          <label>Width <select name="width"><option value="89">single column, 89 mm</option><option value="120" selected>1.5 columns, 120 mm</option><option value="183">double column, 183 mm</option></select></label>
          <label>Show <select name="srcFilter"><option value="">all sources together</option></select></label>
          <label>Terms shown <input type="number" name="topN" value="15" min="3" max="40" /></label>
          <label>x axis <select name="xAxis"><option value="fold">fold enrichment</option><option value="p">−log10 adjusted p</option></select></label>
          <label>Font size <select name="font"><option value="7">7 pt</option><option value="8" selected>8 pt</option></select></label>
        </fieldset>
        <button type="submit" class="btn btn-primary" data-run>Run enrichment</button>
        <p class="small muted en-status" data-status></p>
      </form>

      <div class="en-out" data-out hidden>
        <div data-lists></div>
        <div class="note small" style="margin-top:2rem"><strong>Reading it honestly.</strong> Enrichment depends on the gene list cutoff, the background and the annotation version; terms with huge sizes (thousands of genes) are rarely informative, and sibling GO terms repeat the same genes. Report the terms as suggestions, show the genes behind them, and state the database version (<span data-version></span>).</div>
      </div>
    </div>
  </div>

  <style>
    .en { display: grid; grid-template-columns: minmax(0, 380px) minmax(0, 1fr); gap: 2rem; align-items: start; }
    @media (max-width: 960px) { .en { grid-template-columns: 1fr; } }
    .en-form fieldset { border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.8rem 1rem 1rem; margin: 0 0 1rem; background: var(--surface); }
    .en-form legend { font-weight: 600; color: var(--ink); padding: 0 0.4rem; }
    .en-form label { display: block; font-size: 0.86rem; color: var(--muted); margin: 0.5rem 0; }
    .en-form textarea, .en-form select, .en-form input[type="number"] { display: block; width: 100%; margin-top: 0.2rem; padding: 0.4rem 0.55rem; font: inherit; font-size: 0.9rem; color: var(--ink); background: var(--bg); border: 1px solid var(--line-strong); border-radius: 6px; }
    .en-form textarea { font-family: var(--f-mono); font-size: 0.8rem; }
    .en-form label.chk { display: flex; align-items: center; gap: 0.5rem; }
    .en-form label.chk input { margin: 0; width: auto; display: inline; }
    .en-sources { display: grid; grid-template-columns: 1fr 1fr; gap: 0 0.5rem; margin: 0.4rem 0; }
    .en-sources label { margin: 0.2rem 0; }
    .en-status:empty { display: none; }
    .en-status.err { color: var(--up); }
    .en-list { margin-bottom: 2.5rem; }
    .en-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
    .en-head h2 { margin: 0; font-size: 1.4rem; }
    .en-head div { display: flex; gap: 0.5rem; }
    .en-head .btn { padding: 0.4rem 0.9rem; font-size: 0.85rem; }
    .en-fig { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.5rem; }
    .en-fig svg { width: 100%; height: auto; }
    .en-table td { font-size: 0.84rem; }
    .en-table td.genes { font-size: 0.75rem; color: var(--muted); max-width: 32ch; white-space: normal; }
    .en-table .src { font-size: 0.72rem; color: var(--dim); }
    .caption { font-size: 0.85rem; color: var(--muted); user-select: all; margin: 0.6rem 0 0; }
    .btn.flash { background: var(--accent); color: #fff; }
  </style>

  <script>
    import { gprofiler, termsCSV, dotPlotSVG, enrichCaption, sourceNames, toEntrez, keggMapURL, type Term, type EnrichOpts, type DotOpts } from "../../scripts/enrich";
    import { svgToPng, download } from "../../scripts/deg";
    const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
    const form = $<HTMLFormElement>("[data-form]"), status = $<HTMLElement>("[data-status]"), out = $<HTMLElement>("[data-out]"), lists = $<HTMLElement>("[data-lists]");
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const val = (n: string) => el(n).value.trim();
    const parseList = (s: string) => [...new Set(s.split(/[\s,;]+/).map((x) => x.trim().replace(/^"|"$/g, "")).filter(Boolean))];
    const say = (m: string, err = false) => { status.textContent = m; status.classList.toggle("err", err); };
    let last: { terms: Term[]; version: string; queries: Record<string, string[]>; eo: EnrichOpts; failed: Record<string, string[]>; mapped: Record<string, number> } | null = null;

    // hand-off from the results tool
    try { const h = sessionStorage.getItem("rr-enrich"); if (h) { const p = JSON.parse(h); el("up").value = p.up.join("\n"); el("down").value = p.down.join("\n"); el("background").value = p.background.join("\n"); $("[data-handoff]").textContent = `Loaded from ${p.source}: ${p.up.length} up, ${p.down.length} down, ${p.background.length} background genes (adjusted p < ${p.thresholds.padj}${p.thresholds.lfc ? `, |log2FC| ≥ ${p.thresholds.lfc}` : ""}).`; } } catch {}
    $("[data-example]").addEventListener("click", async () => {
      say("Loading the airway results…");
      const txt = await fetch("/data/airway_deseq2_results.csv").then((r) => r.text());
      const rows = txt.trim().split("\n").slice(1).map((l) => l.split(",").map((x) => x.replace(/"/g, "")));
      const tested = rows.filter((r) => r[7] !== "NA");
      el("up").value = tested.filter((r) => +r[7] < 0.05 && +r[3] > 1).map((r) => r[0]).join("\n");
      el("down").value = tested.filter((r) => +r[7] < 0.05 && +r[3] < -1).map((r) => r[0]).join("\n");
      el("background").value = tested.map((r) => r[0]).join("\n");
      (el("organism") as HTMLSelectElement).value = "hsapiens";
      $("[data-handoff]").textContent = "Airway: dexamethasone vs untreated, adjusted p < 0.05 and |log2FC| > 1, background = 15,826 tested genes.";
      say("");
    });

    const opts = (): EnrichOpts => ({ organism: val("organism"), sources: Array.from(form.querySelectorAll<HTMLInputElement>('input[name="src"]:checked')).map((c) => c.value), method: val("method") as EnrichOpts["method"], threshold: parseFloat(val("threshold")) || 0.05, background: parseList(val("background")).length ? parseList(val("background")) : null, noIEA: (el("noIEA") as HTMLInputElement).checked });
    const dotOpts = (): DotOpts => ({ widthMm: +val("width"), heightMm: 0, fontPt: +val("font"), topN: +val("topN") || 15, xAxis: val("xAxis") as "fold" | "p" });
    const sizeOK = (t: Term) => t.termSize >= (+val("minSize") || 1) && t.termSize <= (+val("maxSize") || 1e9);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const queries: Record<string, string[]> = {};
      const up = parseList(val("up")), down = parseList(val("down"));
      if (up.length) queries["up-regulated"] = up;
      if (down.length) queries["down-regulated"] = down;
      if (!Object.keys(queries).length) { say("Paste at least one gene list.", true); return; }
      const eo = opts();
      if (!eo.sources.length) { say("Tick at least one data source.", true); return; }
      const btn = $<HTMLButtonElement>("[data-run]"); btn.disabled = true; say("Sending the lists to g:Profiler… (5–20 seconds)");
      try {
        const r = await gprofiler(queries, eo);
        last = { ...r, queries, eo };
        const sel = el("srcFilter") as HTMLSelectElement, had = sel.value;
        sel.innerHTML = `<option value="">all sources together</option>` + eo.sources.map((src) => `<option value="${src}">${sourceNames[src] ?? src} only</option>`).join("");
        if ([...sel.options].some((o) => o.value === had)) sel.value = had;
        render();
        const fails = Object.entries(r.failed).filter(([, f]) => f.length).map(([q, f]) => `${f.length} of the ${q} IDs not recognised`).join("; ");
        say(`${r.terms.length} significant terms (g:Profiler data ${r.version}).${fails ? " " + fails + "." : ""}`);
      } catch (err) { say(`Could not run the enrichment: ${(err as Error).message}`, true); }
      btn.disabled = false;
    });
    form.querySelectorAll<HTMLInputElement>('[name="minSize"], [name="maxSize"], [name="width"], [name="topN"], [name="xAxis"], [name="font"], [name="srcFilter"]').forEach((i) => i.addEventListener("input", () => last && render()));

    const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
    const flash = (b: HTMLElement, t: string) => { const o = b.textContent; b.textContent = t; b.classList.add("flash"); setTimeout(() => { b.textContent = o; b.classList.remove("flash"); }, 1500); };
    // show human gene symbols next to Ensembl IDs in the table
    let symbols: Record<string, string> | null = null;
    async function loadSymbols() { if (symbols || val("organism") !== "hsapiens") return; try { symbols = await fetch("/data/symbols_human.json").then((r) => r.json()); render(); } catch {} }
    const sym = (id: string) => (symbols && symbols[id.replace(/\..*$/, "")]) || id;
    function render() {
      if (!last) return;
      if (!symbols && val("organism") === "hsapiens" && /^ENSG/.test(Object.values(last.queries)[0]?.[0] ?? "")) loadSymbols();
      const { terms, version, queries, eo } = last;
      $("[data-version]").textContent = version;
      lists.innerHTML = "";
      for (const q of Object.keys(queries)) {
        const srcF = val("srcFilter");
        const tAll = terms.filter((t) => t.query === q && sizeOK(t));
        const tq = tAll.filter((t) => !srcF || t.source === srcF).sort((a, b) => a.p - b.p);
        const perSource = eo.sources.map((src) => `${sourceNames[src] ?? src} ${tAll.filter((t) => t.source === src).length}`).join(" · ");
        const o = dotOpts(); o.heightMm = Math.max(45, Math.min(o.topN, tq.length) * 4.2 + 18); o.title = q.charAt(0).toUpperCase() + q.slice(1);
        const sec = document.createElement("section"); sec.className = "en-list";
        const svg = tq.length ? dotPlotSVG(tq, o) : "";
        sec.innerHTML = `<div class="en-head" style="align-items:flex-start"><div><h2>${esc(o.title)} <span class="muted small">· ${queries[q].length} genes, ${last.mapped[q]} recognised</span></h2><p class="small muted" style="margin:0 0 .4rem">Significant terms after the size filter: ${esc(perSource)}${srcF ? ` · showing ${esc(sourceNames[srcF] ?? srcF)}` : ""}. A zero means the source was tested and nothing passed the threshold.</p></div><div><button class="btn btn-ghost" data-x="svg">SVG</button><button class="btn btn-ghost" data-x="png">PNG 300 dpi</button><button class="btn btn-ghost" data-x="csv">CSV</button></div></div>` +
          (tq.length ? `<div class="en-fig">${svg}</div><p class="caption">${esc(enrichCaption(tq, q, o, eo, version, queries[q].length))}</p>` : `<p class="muted">No term passes the threshold for this list.</p>`) +
          `<div class="table-wrap"><table class="en-table"><thead><tr><th>Term</th><th class="num">overlap / size</th><th class="num">fold</th><th class="num">adj. p</th><th>genes</th></tr></thead><tbody>${tq.slice(0, 60).map((t) => `<tr><td>${esc(t.name)}<div class="src">${esc(t.source)} · ${esc(t.id)}${t.source === "KEGG" ? ` · <a href="#" data-kegg="${esc(t.id)}" title="Open this pathway on kegg.jp with your genes highlighted">pathway map ↗</a>` : ""}</div></td><td class="num">${t.overlap} / ${t.termSize}</td><td class="num">${t.fold.toFixed(2)}</td><td class="num">${t.p.toExponential(1)}</td><td class="genes">${esc(t.genes.slice(0, 12).map(sym).join(", "))}${t.genes.length > 12 ? ` +${t.genes.length - 12}` : ""}</td></tr>`).join("")}</tbody></table></div>${tq.length > 60 ? `<p class="small muted">Showing 60 of ${tq.length}; the CSV has all.</p>` : ""}`;
        sec.querySelectorAll<HTMLAnchorElement>("[data-kegg]").forEach((a) => a.addEventListener("click", async (ev) => {
          ev.preventDefault();
          const term = tq.find((t) => t.id === a.dataset.kegg); if (!term) return;
          const o0 = a.textContent; a.textContent = "converting IDs…";
          try { const ent = await toEntrez(eo.organism, term.genes); const url = keggMapURL(eo.organism, term.id, ent); window.open(url, "_blank", "noopener"); a.textContent = ent.length ? `pathway map ↗ (${ent.length} genes)` : "pathway map ↗ (no Entrez IDs found)"; }
          catch { a.textContent = "could not convert IDs"; }
          setTimeout(() => (a.textContent = o0), 4000);
        }));
        sec.querySelectorAll<HTMLButtonElement>("[data-x]").forEach((b) => b.addEventListener("click", async () => {
          const stem = `enrichment_${q.replace(/[^a-z]/g, "")}${srcF ? "_" + srcF.replace(/[^A-Za-z]/g, "") : ""}`;
          if (b.dataset.x === "csv") { download(`${stem}.csv`, termsCSV(tq), "text/csv"); flash(b, "Saved"); }
          else if (b.dataset.x === "svg") { download(`${stem}_dotplot.svg`, svg, "image/svg+xml"); flash(b, "Saved"); }
          else { b.textContent = "Rendering…"; try { download(`${stem}_dotplot_300dpi.png`, await svgToPng(svg, o.widthMm, o.heightMm, 300)); flash(b, "Saved"); } catch { flash(b, "Failed"); } }
        }));
        lists.appendChild(sec);
      }
      out.hidden = false;
    }
    (window as any).__en = { get last() { return last; }, dotPlotSVG, dotOpts };
  </script>
</Base>
