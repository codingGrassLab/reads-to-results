          <div class="acts"><button type="button" class="btn btn-primary" data-use="${r.acc}">Use this dataset →</button>${r.counts ? `<a class="btn btn-ghost" href="https://www.ncbi.nlm.nih.gov/geo/download/?type=rnaseq_counts&acc=${r.acc}" target="_blank" rel="noopener">NCBI counts ↗</a>` : ""}</div>
        </div>`).join("");
        fres.querySelectorAll<HTMLButtonElement>("[data-use]").forEach((b) => b.addEventListener("click", () => { (form.elements.namedItem("acc") as HTMLInputElement).value = b.dataset.use!; lookup(b.dataset.use!); setTimeout(() => $<HTMLElement>("[data-form]").scrollIntoView({ behavior: "smooth", block: "start" }), 100); }));
        const hidden = rows.length - shown.length;
        fsay(`${count.toLocaleString("en-US")} datasets match; showing ${start + 1}–${start + rows.length}${hidden ? ` (${hidden} on this page hidden by the sample/single-cell filters)` : ""}.`);
        $<HTMLElement>("[data-find-csv]").hidden = false;
        pager.hidden = count <= PAGE; $<HTMLButtonElement>("[data-prev]").disabled = start === 0; $<HTMLButtonElement>("[data-next]").disabled = start + PAGE >= count;
