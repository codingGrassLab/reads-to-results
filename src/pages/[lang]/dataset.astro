      const q = fv("q"); if (q) parts.push(`(${q})`);
      const org = fv("org"); if (org) parts.push(`"${org}"[Organism]`);
      parts.push(`"expression profiling by high throughput sequencing"[DataSet Type]`, `gse[Entry Type]`);
      const from = fv("from"); if (from) parts.push(`${from}/01/01:3000/12/31[Publication Date]`);
      if ((ff.elements.namedItem("counts") as HTMLInputElement).checked) parts.push(`"rnaseq counts"[Filter]`);
      return parts.join(" AND ");
    }
    async function findPage(start: number) {
      const term = buildTerm();
      fsay("Searching GEO…"); pager.hidden = true;
      try {
        const es = await fetch(`${EU}esearch.fcgi?db=gds&term=${encodeURIComponent(term)}&retmode=json&retmax=${PAGE}&retstart=${start}&sort=date`).then((r) => r.json());
        const ids: string[] = es.esearchresult?.idlist ?? []; const count = +(es.esearchresult?.count ?? 0);
        if (!ids.length) { fres.innerHTML = ""; fsay(count ? "No more results." : "Nothing found. Try fewer words, or a broader term.", !count); $<HTMLElement>("[data-find-csv]").hidden = true; return; }
        const sum = await fetch(`${EU}esummary.fcgi?db=gds&id=${ids.join(",")}&retmode=json`).then((r) => r.json());
        // which of these have an NCBI-generated count matrix (one extra query, only when not already filtered)
        let countsIds = new Set<string>(ids);
        if (!(ff.elements.namedItem("counts") as HTMLInputElement).checked) {
          const es2 = await fetch(`${EU}esearch.fcgi?db=gds&term=${encodeURIComponent(`(${ids.map((i) => i + "[UID]").join(" OR ")}) AND "rnaseq counts"[Filter]`)}&retmode=json&retmax=${PAGE}`).then((r) => r.json()).catch(() => null);
          countsIds = new Set<string>(es2?.esearchresult?.idlist ?? []);
        }
        const minN = +fv("minN") || 0, hideSc = (ff.elements.namedItem("nosc") as HTMLInputElement).checked;
        const rows = ids.map((i) => sum.result?.[i]).filter(Boolean).map((r: any) => ({
          uid: r.uid, acc: r.accession, title: r.title, summary: r.summary || "", taxon: r.taxon, n: +r.n_samples || 0, date: (r.pdat || "").replace(/\//g, "-"), bioproject: r.bioproject || "",
          sra: (r.extrelations || []).some((x: any) => x.relationtype === "SRA") || !!r.bioproject, counts: countsIds.has(String(r.uid)), sc: scRe.test(`${r.title} ${r.summary}`), samples: (r.samples || []).map((x: any) => x.title),
        }));
        findState = { term, count, start, rows, countsIds };
        const shown = rows.filter((r) => r.n >= minN && !(hideSc && r.sc));
        fres.innerHTML = shown.map((r) => `<div class="ds-card">
          <div class="meta"><a href="https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=${r.acc}" target="_blank" rel="noopener"><b>${r.acc}</b></a><span>${esc(r.taxon)}</span><span>${r.n} samples</span><span>${r.date}</span>${r.bioproject ? `<span>${esc(r.bioproject)}</span>` : ""}</div>
          <h3>${esc(r.title)}</h3>
