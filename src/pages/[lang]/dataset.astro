      const csv = ["accession,title,organism,samples,published,bioproject,ncbi_count_matrix,sra,single_cell_guess,geo_url", ...findState.rows.map((r) => [r.acc, q(r.title), q(r.taxon), r.n, r.date, r.bioproject, r.counts ? 1 : 0, r.sra ? 1 : 0, r.sc ? 1 : 0, `https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=${r.acc}`].join(","))].join("\n") + "\n";
