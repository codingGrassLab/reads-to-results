    const EU = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/";
    const ff = $<HTMLFormElement>("[data-find]"), fstatus = $<HTMLElement>("[data-find-status]"), fres = $<HTMLElement>("[data-find-results]"), pager = $<HTMLElement>("[data-find-pager]");
    const fsay = (m: string, err = false) => { fstatus.textContent = m; fstatus.classList.toggle("err", err); };
    const fv = (n: string) => (ff.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement).value.trim();
    const PAGE = 20;
    let findState = { term: "", count: 0, start: 0, rows: [] as any[], countsIds: new Set<string>() };
