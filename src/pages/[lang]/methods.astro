---
import Base from "../../layouts/Base.astro";
import { langs, t, type Lang } from "../../i18n/ui";
import citations from "../../data/citations.json";
import versions from "../../data/versions.json";
import salmon from "../../data/salmon.json";
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const title = "Methods writer";
const description = "Fill in the tools, versions and settings of your RNA-seq analysis and get a methods paragraph with correct citations, plus a BibTeX file.";
// the airway values, as the example
const example = {
  accession: "SRA SRP033351 (GEO GSE52778)", organism: "human", layout: "paired", readlen: "63–126",
  fastqc: "0.12.1", multiqc: "1.25", fastp: "0.23.4", minlen: "30",
  salmon: salmon.SRR1039508.salmon_version, annot: "gencode", release: "29", build: "GRCh38", decoy: true, k: "31", libtype: "IU", gcbias: true, seqbias: false,
  tximport: "1.34.0", deseq2: versions.packages.DESeq2, design: "~ cell + dex", contrast: "dexamethasone-treated versus untreated", filter_counts: "10", filter_samples: "4", alpha: "0.05", lfc: "1", shrink: "apeglm", apeglm: versions.packages.apeglm,
  enrich: "ora", clusterprofiler: versions.packages.clusterProfiler, ontology: "GO Biological Process", orgdb: versions.packages["org.Hs.eg.db"], r: versions.r.replace("R version ", "").split(" ")[0],
};
---
<Base lang={lang} title={title} description={description} active="methods">
  <div class="container">
    <div class="page-head prose">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <p class="small muted">Nothing you type leaves your browser. The text is a draft: check every setting against what you actually ran, and read the papers you cite. In the example, the Salmon, DESeq2, apeglm, clusterProfiler and R versions are the ones used on this site; the others are illustrative.</p>
    </div>

    <div class="mw">
      <form class="mw-form" data-form autocomplete="off">
        <div class="mw-actions">
          <button type="button" class="btn btn-ghost" data-example>Fill with an example (airway)</button>
          <button type="button" class="btn btn-ghost" data-clear>Clear</button>
        </div>

        <fieldset>
          <legend>Data</legend>
          <label>Data source / accession <input name="accession" placeholder="e.g. SRA SRP033351, or 'generated in this study'" /></label>
          <label>Organism
            <select name="organism"><option value="human">human (Homo sapiens)</option><option value="mouse">mouse (Mus musculus)</option><option value="other">other (write it in the text)</option></select>
          </label>
          <label>Library layout <select name="layout"><option value="paired">paired-end</option><option value="single">single-end</option></select></label>
          <label>Read length (bp) <input name="readlen" placeholder="e.g. 2 × 100" /></label>
        </fieldset>

        <fieldset>
          <legend>Quality control and trimming</legend>
          <label>FastQC version <input name="fastqc" placeholder="leave empty if not used" /></label>
          <label>MultiQC version <input name="multiqc" placeholder="leave empty if not used" /></label>
          <label>fastp version <input name="fastp" placeholder="leave empty if no trimming" /></label>
          <label>Minimum read length after trimming <input name="minlen" placeholder="e.g. 30" /></label>
        </fieldset>

        <fieldset>
          <legend>Quantification (Salmon)</legend>
          <label>Salmon version <input name="salmon" placeholder="e.g. 1.10.3" required /></label>
          <label>Annotation <select name="annot"><option value="gencode">GENCODE</option><option value="ensembl">Ensembl</option></select></label>
          <label>Release <input name="release" placeholder="e.g. 47 (GENCODE) or 113 (Ensembl)" /></label>
          <label>Genome build <input name="build" placeholder="e.g. GRCh38" /></label>
          <label class="chk"><input type="checkbox" name="decoy" checked /> decoy-aware index (genome as decoy)</label>
          <label>k-mer length <input name="k" placeholder="31" /></label>
          <label>Library type as detected (<code>-l A</code>) <select name="libtype"><option value="IU">IU (unstranded)</option><option value="ISR">ISR (stranded, dUTP)</option><option value="ISF">ISF (stranded, sense)</option><option value="U">U (single-end, unstranded)</option><option value="SR">SR (single-end, stranded)</option><option value="SF">SF (single-end, sense)</option></select></label>
          <label class="chk"><input type="checkbox" name="gcbias" checked /> <code>--gcBias</code></label>
          <label class="chk"><input type="checkbox" name="seqbias" /> <code>--seqBias</code></label>
        </fieldset>

        <fieldset>
          <legend>Gene-level import</legend>
          <label>tximport version <input name="tximport" placeholder="e.g. 1.34.0" /></label>
        </fieldset>

        <fieldset>
          <legend>Differential expression (DESeq2)</legend>
          <label>DESeq2 version <input name="deseq2" placeholder="e.g. 1.46.0" required /></label>
          <label>Design formula <input name="design" placeholder="e.g. ~ batch + condition" /></label>
          <label>Comparison, in words <input name="contrast" placeholder="e.g. treated versus control" /></label>
          <label>Pre-filter: minimum counts <input name="filter_counts" placeholder="e.g. 10" /></label>
          <label>… in at least this many samples <input name="filter_samples" placeholder="e.g. 3" /></label>
          <label>Adjusted p threshold <input name="alpha" placeholder="0.05" /></label>
          <label>|log2 fold change| threshold (optional) <input name="lfc" placeholder="leave empty for none" /></label>
          <label>Fold-change shrinkage <select name="shrink"><option value="none">none</option><option value="apeglm">apeglm</option><option value="ashr">ashr</option><option value="normal">normal (DESeq2 built-in)</option></select></label>
          <label>apeglm version <input name="apeglm" placeholder="if used" /></label>
        </fieldset>

        <fieldset>
          <legend>Enrichment</legend>
          <label>Method <select name="enrich"><option value="none">none</option><option value="ora">over-representation (enrichGO / enrichKEGG)</option><option value="gsea">GSEA (gseGO / gseKEGG)</option></select></label>
          <label>clusterProfiler version <input name="clusterprofiler" placeholder="e.g. 4.14.4" /></label>
          <label>Database / ontology <input name="ontology" placeholder="e.g. GO Biological Process" /></label>
          <label>org.*.eg.db version <input name="orgdb" placeholder="e.g. 3.20.0" /></label>
        </fieldset>

        <fieldset>
          <legend>Environment</legend>
          <label>R version <input name="r" placeholder="e.g. 4.4.2" /></label>
        </fieldset>
      </form>

      <div class="mw-out">
        <div class="mw-outhead">
          <h2 style="margin:0">Methods</h2>
          <div>
            <button type="button" class="btn btn-ghost" data-copy>Copy text</button>
            <button type="button" class="btn btn-ghost" data-bib>Download BibTeX</button>
          </div>
        </div>
        <div class="mw-text prose" data-text></div>
        <h3>References</h3>
        <ol class="mw-refs" data-refs></ol>
      </div>
    </div>

    <div class="prose" style="margin-top:3rem">
      <h2>How the citations were chosen</h2>
      <p>Each tool is cited by the paper its authors ask you to cite. The list, with DOIs, is below; every DOI was resolved and the bibliographic details checked against the publisher's page when this site was built. If a tool has a newer paper when you read this, cite that one.</p>
      <div class="table-wrap"><table>
        <thead><tr><th>Tool</th><th>Reference</th></tr></thead>
        <tbody>{Object.entries(citations).map(([k, c]) => <tr><td><code>{k}</code></td><td>{c.authors} ({c.year}). {c.title}. <i>{c.journal}</i>{c.volume ? ` ${c.volume}` : ""}{c.issue ? `(${c.issue})` : ""}{c.pages ? `: ${c.pages}` : ""}. {c.doi ? <a href={`https://doi.org/${c.doi}`}>doi:{c.doi}</a> : <a href={c.url}>{c.url}</a>}</td></tr>)}</tbody>
      </table></div>
    </div>
  </div>

  <script type="application/json" data-json="citations" set:html={JSON.stringify(citations)} />
  <script type="application/json" data-json="example" set:html={JSON.stringify(example)} />

  <style>
    .mw { display: grid; grid-template-columns: minmax(0, 420px) minmax(0, 1fr); gap: 2.5rem; align-items: start; }
    @media (max-width: 900px) { .mw { grid-template-columns: 1fr; } }
    .mw-form fieldset { border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.8rem 1rem 1rem; margin: 0 0 1rem; background: var(--surface); }
    .mw-form legend { font-weight: 600; color: var(--ink); padding: 0 0.4rem; }
    .mw-form label { display: block; font-size: 0.88rem; color: var(--muted); margin: 0.55rem 0; }
    .mw-form input:not([type="checkbox"]), .mw-form select { display: block; width: 100%; margin-top: 0.25rem; padding: 0.45rem 0.6rem; font: inherit; font-size: 0.95rem; color: var(--ink); background: var(--bg); border: 1px solid var(--line-strong); border-radius: 6px; }
    .mw-form input:focus, .mw-form select:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
    .mw-form label.chk { display: flex; align-items: center; gap: 0.5rem; }
    .mw-actions { display: flex; gap: 0.6rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .mw-out { position: sticky; top: calc(var(--header-h) + 1.5rem); }
    .mw-outhead { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .mw-outhead div { display: flex; gap: 0.5rem; }
    .mw-text { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 1.2rem 1.4rem; font-size: 1rem; line-height: 1.75; min-height: 8rem; }
    .mw-text p:last-child { margin-bottom: 0; }
    .mw-refs { font-size: 0.9rem; color: var(--muted); padding-left: 1.4rem; }
    .mw-refs li { margin-bottom: 0.4em; }
    .btn.flash { background: var(--accent); color: #fff; }
  </style>

  <script>
    type Cit = { key: string; authors: string; title: string; journal: string; year: number; volume?: string; issue?: string; pages?: string; doi?: string; url?: string; type?: string; note?: string };
    const cits = JSON.parse(document.querySelector('[data-json="citations"]')!.textContent!) as Record<string, Cit>;
    const example = JSON.parse(document.querySelector('[data-json="example"]')!.textContent!) as Record<string, string | boolean>;
    const form = document.querySelector<HTMLFormElement>("[data-form]")!;
    const out = document.querySelector<HTMLElement>("[data-text]")!;
    const refsEl = document.querySelector<HTMLElement>("[data-refs]")!;
    const STORE = "methods-writer";

    const v = (name: string) => { const el = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null; if (!el) return ""; return el instanceof HTMLInputElement && el.type === "checkbox" ? (el.checked ? "1" : "") : el.value.trim(); };
    const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
    const libWords: Record<string, string> = { IU: "unstranded, paired-end (IU)", ISR: "stranded, paired-end, read 1 antisense (ISR)", ISF: "stranded, paired-end, read 1 sense (ISF)", U: "unstranded, single-end (U)", SR: "stranded, single-end, antisense (SR)", SF: "stranded, single-end, sense (SF)" };

    function generate() {
      const used: string[] = [];
      const cite = (k: string) => { if (!cits[k]) return ""; if (!used.includes(k)) used.push(k); return `[${used.indexOf(k) + 1}]`; };
      const paras: string[] = [];
      const org = v("organism"), build = v("build"), annot = v("annot"), rel = v("release");
      const orgName = org === "human" ? "human" : org === "mouse" ? "mouse" : "[organism]";
      const annotName = annot === "gencode" ? `GENCODE${rel ? " release " + rel : ""}` : `Ensembl${rel ? " release " + rel : ""}`;

      // data and QC
      let p1 = "";
      if (v("accession")) p1 += `Raw ${v("layout") === "paired" ? "paired-end" : "single-end"} RNA-seq reads${v("readlen") ? ` (${v("readlen")} bp)` : ""} were obtained from ${esc(v("accession"))}${/SRA|SRP|SRR|ERP/i.test(v("accession")) ? " " + cite("sra") : ""}. `;
      else p1 += `${v("layout") === "paired" ? "Paired-end" : "Single-end"} RNA-seq reads${v("readlen") ? ` (${v("readlen")} bp)` : ""} were generated as described above. `;
      const qc: string[] = [];
      if (v("fastqc")) qc.push(`FastQC v${v("fastqc")} ${cite("fastqc")}`);
      if (v("multiqc")) qc.push(`MultiQC v${v("multiqc")} ${cite("multiqc")}`);
      if (qc.length) p1 += `Read quality was assessed with ${qc.join(" and ")}. `;
      if (v("fastp")) p1 += `Adapter sequences were removed with fastp v${v("fastp")} ${cite("fastp")} using automatic adapter detection${v("minlen") ? `; reads shorter than ${v("minlen")} bp after trimming were discarded` : ""}. `;
      else p1 += `Reads were not trimmed, since Salmon's selective alignment tolerates adapter-containing read ends. `;
      paras.push(p1.trim());

      // quantification
      let p2 = `Transcript abundances were quantified with Salmon v${v("salmon") || "[version]"} ${cite("salmon")} `;
      p2 += `against the ${orgName} ${annotName} transcriptome${build ? ` (${build})` : ""} ${annot === "gencode" ? cite("gencode") : cite("ensembl")}`;
      p2 += v("decoy") ? `, using a decoy-aware index in which the full genome sequence served as decoy ${cite("selective")}` : "";
      p2 += v("k") && v("k") !== "31" ? ` with k = ${v("k")}` : "";
      p2 += `. Reads were mapped with selective alignment (\`--validateMappings\`)`;
      const biases: string[] = [];
      if (v("gcbias")) biases.push("fragment GC content (`--gcBias`)");
      if (v("seqbias")) biases.push("sequence-specific start bias (`--seqBias`)");
      if (biases.length) p2 += ` with correction for ${biases.join(" and ")}`;
      p2 += `. The library type was inferred automatically (\`--libType A\`) and detected as ${libWords[v("libtype")] ?? v("libtype")} for all samples. `;
      p2 += `Transcript-level estimated counts were summarised to gene level with tximport${v("tximport") ? ` v${v("tximport")}` : ""} ${cite("tximport")}, using a transcript-to-gene table derived from the ${annotName} annotation, and the average transcript length per gene and sample was passed to DESeq2 as an offset.`;
      paras.push(p2.replace(/`/g, ""));

      // DE
      const alpha = v("alpha") || "0.05";
      let p3 = `Differential expression was analysed with DESeq2 v${v("deseq2") || "[version]"} ${cite("deseq2")}`;
      p3 += v("design") ? ` using the design formula ${esc(v("design"))}` : "";
      p3 += `. `;
      if (v("filter_counts")) p3 += `Genes with fewer than ${v("filter_counts")} counts in at least ${v("filter_samples") || "[n]"} samples were removed before testing. `;
      p3 += `Size factors were estimated by the median-of-ratios method, dispersions were estimated with empirical-Bayes shrinkage towards a fitted mean–dispersion trend, and ${v("contrast") ? `the contrast ${esc(v("contrast"))} was` : "contrasts were"} tested with the Wald test. `;
      p3 += `P-values were adjusted for multiple testing with the Benjamini–Hochberg procedure ${cite("bh")}, and genes with an adjusted p-value below ${alpha}${v("lfc") ? ` and an absolute log2 fold change above ${v("lfc")}` : ""} were considered differentially expressed. `;
      const sh = v("shrink");
      if (sh === "apeglm") p3 += `Log2 fold changes were shrunk with the apeglm estimator${v("apeglm") ? ` (apeglm v${v("apeglm")})` : ""} ${cite("apeglm")} for ranking and visualisation. `;
      else if (sh === "ashr") p3 += `Log2 fold changes were shrunk with the ashr estimator for ranking and visualisation. `;
      else if (sh === "normal") p3 += `Log2 fold changes were shrunk with DESeq2's normal prior for ranking and visualisation. `;
      paras.push(p3.trim());

      // enrichment
      const en = v("enrich");
      if (en !== "none") {
        let p4 = "";
        const ont = v("ontology") || "Gene Ontology Biological Process";
        const goCite = () => (/gene ontology|^GO/i.test(ont) ? " " + cite("go") : "");
        if (en === "ora") p4 += `Over-representation analysis of the differentially expressed genes was performed with clusterProfiler${v("clusterprofiler") ? ` v${v("clusterprofiler")}` : ""} ${cite("clusterprofiler")} against ${ont}${goCite()}${v("orgdb") ? ` (org.*.eg.db v${v("orgdb")})` : ""}, using all genes tested for differential expression as the background, with Benjamini–Hochberg-adjusted p-values below 0.05 considered significant.`;
        else p4 += `Gene set enrichment analysis ${cite("gsea")} was performed with clusterProfiler${v("clusterprofiler") ? ` v${v("clusterprofiler")}` : ""} ${cite("clusterprofiler")} against ${ont}${goCite()}${v("orgdb") ? ` (org.*.eg.db v${v("orgdb")})` : ""}, ranking all tested genes by the DESeq2 Wald statistic, with Benjamini–Hochberg-adjusted p-values below 0.05 considered significant.`;
        paras.push(p4);
      }
      paras.push(`All statistical analyses were performed in R${v("r") ? ` v${v("r")}` : ""} ${cite("r")}.`);

      out.innerHTML = paras.map((p) => `<p>${p}</p>`).join("");
      refsEl.innerHTML = used.map((k) => `<li>${fmt(cits[k])}</li>`).join("");
      (window as any).__mwUsed = used;
    }

    function fmt(c: Cit) {
      const vol = c.volume ? ` ${c.volume}` : "", iss = c.issue ? `(${c.issue})` : "", pg = c.pages ? `:${c.pages}` : "";
      const tail = c.doi ? ` doi:${c.doi}` : c.url ? ` ${c.url}` : "";
      const au = esc(c.authors.replace(/\.$/, ""));
      if (c.type === "software") return `${au}. ${esc(c.title)}. ${esc(c.journal)}, ${c.year}. ${c.url}`;
      return `${au}. ${esc(c.title)}. <i>${esc(c.journal)}</i> ${c.year};${vol}${iss}${pg}.${tail}`;
    }

    function bibtex() {
      const used: string[] = (window as any).__mwUsed ?? [];
      return used.map((k) => {
        const c = cits[k];
        const authors = c.authors.replace(/, et al\.?/, "").split(", ").map((a) => a.replace(/^([A-Za-zÀ-ž'-]+) ([A-Z]+)$/, "$1, $2")).join(" and ") + (/et al/.test(c.authors) ? " and others" : "");
        if (c.type === "software") return `@misc{${c.key},\n  author = {${authors}},\n  title = {${c.title}},\n  year = {${c.year}},\n  howpublished = {${c.journal}},\n  url = {${c.url}}\n}`;
        return `@article{${c.key},\n  author = {${authors}},\n  title = {${c.title}},\n  journal = {${c.journal}},\n  year = {${c.year}},${c.volume ? `\n  volume = {${c.volume}},` : ""}${c.issue ? `\n  number = {${c.issue}},` : ""}${c.pages ? `\n  pages = {${c.pages.replace("-", "--")}},` : ""}\n  doi = {${c.doi}}\n}`;
      }).join("\n\n") + "\n";
    }

    function save() { const o: Record<string, string> = {}; for (const el of Array.from(form.elements) as HTMLInputElement[]) if (el.name) o[el.name] = v(el.name); try { localStorage.setItem(STORE, JSON.stringify(o)); } catch {} }
    function load(o: Record<string, string | boolean>) {
      for (const el of Array.from(form.elements) as HTMLInputElement[]) {
        if (!el.name || !(el.name in o)) continue;
        const val = o[el.name];
        if (el.type === "checkbox") el.checked = val === true || val === "1"; else el.value = String(val);
      }
    }
    form.addEventListener("input", () => { generate(); save(); });
    form.querySelector("[data-example]")!.addEventListener("click", () => { load(example); generate(); save(); });
    form.querySelector("[data-clear]")!.addEventListener("click", () => { form.reset(); generate(); save(); });
    const flash = (b: HTMLButtonElement, txt: string) => { const o = b.textContent; b.textContent = txt; b.classList.add("flash"); setTimeout(() => { b.textContent = o; b.classList.remove("flash"); }, 1500); };
    document.querySelector<HTMLButtonElement>("[data-copy]")!.addEventListener("click", async (e) => {
      const refs = Array.from(refsEl.querySelectorAll("li")).map((li, i) => `[${i + 1}] ${li.textContent}`).join("\n");
      try { await navigator.clipboard.writeText(out.innerText + "\n\nReferences\n" + refs); flash(e.currentTarget as HTMLButtonElement, "Copied"); } catch {}
    });
    document.querySelector<HTMLButtonElement>("[data-bib]")!.addEventListener("click", (e) => {
      const blob = new Blob([bibtex()], { type: "application/x-bibtex" });
      const a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = "methods.bib"; a.click(); URL.revokeObjectURL(a.href);
      flash(e.currentTarget as HTMLButtonElement, "Saved methods.bib");
    });
    (window as any).__mwBibtex = bibtex;
    try { const saved = localStorage.getItem(STORE); if (saved) load(JSON.parse(saved)); } catch {}
    const q = new URLSearchParams(location.search);
    if (q.has("padj") || q.has("lfc")) { load({ alpha: q.get("padj") ?? "", lfc: q.get("lfc") ?? "" }); save(); }
    generate();
  </script>
</Base>
