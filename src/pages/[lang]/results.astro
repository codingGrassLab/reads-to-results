---
import Base from "../../layouts/Base.astro";
import { langs, path, type Lang } from "../../i18n/ui";
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const title = "Explore your results";
const description = "Upload a DESeq2, edgeR or limma results table, set your thresholds, and download the significant genes and publication-ready volcano and MA plots. The table stays in your browser (only an optional gene-symbol lookup sends the gene IDs to g:Profiler).";
---
<Base lang={lang} title={title} description={description} active="results">
  <div class="container">
    <div class="page-head prose">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </div>

    <section class="rt-upload" data-upload>
      <div class="drop" data-drop tabindex="0" role="button" aria-label="Choose or drop a results file">
        <input type="file" accept=".csv,.tsv,.txt,.tab" data-file hidden />
        <strong>Drop your results file here, or click to choose</strong>
        <span class="muted small">CSV or TSV from DESeq2 <code>results()</code>, edgeR <code>topTags()</code> or limma <code>topTable()</code>. Columns are detected automatically.</span>
      </div>
      <div class="rt-or"><span>or</span><button type="button" class="btn btn-ghost" data-example>Try with the airway results (DESeq2, 15,826 genes)</button></div>
      <p class="rt-status small muted" data-status></p>
    </section>

    <section class="rt-main" data-main hidden>
      <div class="rt-side">
        <div class="box">
          <h3>Columns</h3>
          <p class="small muted" data-format></p>
          <div class="small rt-sym" data-sym hidden></div>
          <div class="map" data-map></div>
        </div>
        <div class="box">
          <h3>Thresholds</h3>
          <label>Adjusted p below <input type="number" step="any" min="0" max="1" value="0.05" data-t="padj" /></label>
          <label>|log2 fold change| at least <input type="number" step="0.25" min="0" value="1" data-t="lfc" /></label>
          <label>Minimum <span data-mean-name>mean expression</span> (0 = none) <input type="number" step="any" min="0" value="0" data-t="minMean" /></label>
        </div>
        <div class="box">
          <h3>Figure</h3>
          <label>Width <select data-f="width"><option value="89">single column, 89 mm</option><option value="120">1.5 columns, 120 mm</option><option value="183">double column, 183 mm</option></select></label>
          <label>Height (mm) <input type="number" min="40" max="250" value="80" data-f="height" /></label>
          <label>Font size <select data-f="font"><option value="7">7 pt</option><option value="8" selected>8 pt</option><option value="9">9 pt</option></select></label>
          <label>Label the top <input type="number" min="0" max="50" value="10" data-f="labelTop" /> genes by adjusted p</label>
          <label>Also label these genes (one per line, symbol or ID) <textarea rows="3" data-f="labels" placeholder="FKBP5&#10;TSC22D3"></textarea></label>
          <label class="chk"><input type="checkbox" checked data-f="lines" /> show threshold lines</label>
          <label>Panel title (optional) <input data-f="title" placeholder="e.g. A  Dexamethasone vs untreated" /></label>
        </div>
      </div>

      <div class="rt-body">
        <div class="stats" data-stats></div>

        <div class="rt-fig">
          <div class="rt-fighead"><h2>Volcano plot</h2><div><button class="btn btn-ghost" data-dl="volcano-svg">SVG</button><button class="btn btn-ghost" data-dl="volcano-png">PNG 300 dpi</button><a class="small" href={path(lang, "read", "volcano")}>How to read it</a></div></div>
          <div class="plot" data-plot="volcano"></div>
          <details><summary class="small">Figure legend (click to show, then copy)</summary><p class="small caption" data-caption="volcano"></p></details>
        </div>

        <div class="rt-fig">
          <div class="rt-fighead"><h2>MA plot</h2><div><button class="btn btn-ghost" data-dl="ma-svg">SVG</button><button class="btn btn-ghost" data-dl="ma-png">PNG 300 dpi</button><a class="small" href={path(lang, "read", "ma-plot")}>How to read it</a></div></div>
          <div class="plot" data-plot="ma"></div>
          <details><summary class="small">Figure legend</summary><p class="small caption" data-caption="ma"></p></details>
        </div>

        <div class="rt-fig">
          <div class="rt-fighead"><h2>Significant genes</h2><div><button class="btn btn-primary" data-dl="csv">Download CSV</button><button class="btn btn-ghost" data-dl="xlsx">Excel (up / down sheets)</button></div></div>
          <p class="small muted" data-tablenote></p>
          <div class="table-wrap"><table data-table><thead><tr><th>Gene</th><th>Symbol</th><th class="num" data-mean-th>mean</th><th class="num">log2FC</th><th class="num">p</th><th class="num">adjusted p</th><th>direction</th></tr></thead><tbody></tbody></table></div>
        </div>

        <div class="rt-fig">
          <div class="rt-fighead"><h2>Everything in one package</h2><div><button class="btn btn-primary" data-dl="zip">Download ZIP</button><a class="btn btn-ghost" data-enrich href="../enrich/">Enrichment of these genes →</a></div></div>
          <p class="small muted">The ZIP holds the results table you uploaded, the significant genes (CSV and Excel), both figures as SVG and 300-dpi PNG, the figure legends and methods sentence, a <code>config.json</code> with every setting, and an HTML report that shows it all. Keep it with your DESeq2 script and the raw data: together they reproduce the figures.</p>
        </div>

        <div class="rt-fig">
          <div class="rt-fighead"><h2>Text for the paper</h2><div><button class="btn btn-ghost" data-copytext>Copy all</button></div></div>
          <p class="small muted">Figure legends for both plots and the sentence that belongs in Methods, all with your thresholds filled in. The <a data-methods-link href="#">Methods writer</a> opens with the same thresholds.</p>
          <div class="mw-text prose" data-papertext></div>
        </div>

        <div class="note small">
          <strong>Reproducibility.</strong> The downloaded files carry the thresholds in their names and the figure legend states them. Keep the original results file and the DESeq2 script with them; this page does not change your results, it filters and draws them.
        </div>
      </div>
    </section>
  </div>

  <style>
    .drop { border: 2px dashed var(--line-strong); border-radius: var(--radius); padding: 2rem 1.5rem; text-align: center; background: var(--surface); cursor: pointer; display: flex; flex-direction: column; gap: 0.5rem; align-items: center; transition: border-color 0.15s, background 0.15s; }
    .drop:hover, .drop.over, .drop:focus-visible { border-color: var(--accent); background: var(--accent-soft); outline: none; }
    .rt-or { display: flex; align-items: center; gap: 1rem; margin: 1rem 0 0.5rem; }
    .rt-or span { color: var(--dim); font-size: 0.9rem; }
    .rt-status:empty { display: none; }
    .rt-status.err { color: var(--up); }
    .rt-main { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 2rem; align-items: start; margin-top: 2rem; }
    @media (max-width: 900px) { .rt-main { grid-template-columns: 1fr; } }
    .rt-side { position: sticky; top: calc(var(--header-h) + 1rem); display: flex; flex-direction: column; gap: 1rem; }
    @media (max-width: 900px) { .rt-side { position: static; } }
    .box { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.9rem 1rem 1rem; }
    .box h3 { margin: 0 0 0.5rem; font-size: 1.05rem; }
    .box label { display: block; font-size: 0.86rem; color: var(--muted); margin: 0.5rem 0; }
    .box input:not([type="checkbox"]), .box select, .box textarea { display: block; width: 100%; margin-top: 0.2rem; padding: 0.35rem 0.5rem; font: inherit; font-size: 0.92rem; color: var(--ink); background: var(--bg); border: 1px solid var(--line-strong); border-radius: 6px; }
    .box label.chk { display: flex; gap: 0.5rem; align-items: center; }
    .box label.chk input { margin: 0; }
    /* the mapping controls are created at runtime, so they need global rules */
    .map :global(label) { display: block; font-size: 0.86rem; color: var(--muted); margin: 0.35rem 0; }
    .map :global(select) { display: block; width: 100%; margin-top: 0.15rem; padding: 0.35rem 0.5rem; font: inherit; font-size: 0.92rem; color: var(--ink); background: var(--bg); border: 1px solid var(--line-strong); border-radius: 6px; }
    .map :global(i) { font-style: italic; }
    .rt-fig { margin-top: 2rem; }
    .rt-fighead { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
    .rt-fighead h2 { margin: 0; font-size: 1.4rem; }
    .rt-fighead div { display: flex; gap: 0.5rem; align-items: center; }
    .rt-fighead .btn { padding: 0.4rem 0.9rem; font-size: 0.85rem; }
    .caption { color: var(--muted); user-select: all; }
    table[data-table] td { font-size: 0.88rem; }
    .btn.flash { background: var(--accent); color: #fff; }
    .mw-text { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 1rem 1.2rem; font-size: 0.95rem; line-height: 1.7; }
    .mw-text p:last-child { margin-bottom: 0; }
    .mw-text h4 { margin: 0.8em 0 0.3em; font-family: var(--f-body); font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--dim); }
    .rt-sym { margin: 0.4rem 0 0.8rem; display: flex; flex-wrap: wrap; gap: 0.4rem 0.6rem; align-items: center; }
    .rt-sym label { display: inline-flex; gap: 0.3rem; align-items: center; }
    .rt-sym .btn { padding: 0.3rem 0.8rem; font-size: 0.85rem; }
  </style>

  <script>
    import { parseTable, autoMap, toRows, classify, significantCSV, figureSVG, figureCaption, svgToPng, download, fmtNum, label, type Row, type Mapping, type Thresholds, type FigureOpts } from "../../scripts/deg";
    import { linear, canvas, canvasAxes, tooltip, fmt } from "../../scripts/plot";
    import { xlsx, zipFiles } from "../../scripts/xlsx";
    import { toSymbols, organismFrom, organisms } from "../../scripts/enrich";
    import { markDone, resetFrom } from "../../scripts/flow";

    const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
    const drop = $<HTMLElement>("[data-drop]"), fileIn = $<HTMLInputElement>("[data-file]"), status = $<HTMLElement>("[data-status]");
    const main = $<HTMLElement>("[data-main]"), mapEl = $<HTMLElement>("[data-map]"), formatEl = $<HTMLElement>("[data-format]");
    let columns: string[] = [], data: string[][] = [], mapping: Mapping | null = null, format = "", rows: Row[] = [], sourceName = "", sourceText = "", organism = "";

    // ── loading ─────────────────────────────────────────────────────────
    const say = (msg: string, err = false) => { status.textContent = msg; status.classList.toggle("err", err); };
    async function loadText(text: string, name: string) {
      try {
        const t = parseTable(text);
        columns = t.columns; data = t.data; sourceName = name; sourceText = text; resetFrom(3); $<HTMLElement>("[data-sym]").hidden = true;
        const am = autoMap(columns);
        mapping = am?.mapping ?? { id: columns[0], symbol: "", mean: "", lfc: "", p: "", padj: "" };
        format = am?.format ?? "";
        renderMap();
        if (!am) { say(`Read ${data.length.toLocaleString("en-US")} rows and ${columns.length} columns, but could not recognise the fold-change and adjusted-p columns. Pick them under "Columns".`, true); main.hidden = false; return; }
        say(`${name}: ${data.length.toLocaleString("en-US")} rows, recognised as ${format} output.`);
        main.hidden = false;
        rebuild();
      } catch (e) { say(`Could not read the file: ${(e as Error).message}`, true); }
    }
    fileIn.addEventListener("change", () => { const f = fileIn.files?.[0]; if (f) f.text().then((t) => loadText(t, f.name)); });
    drop.addEventListener("click", () => fileIn.click());
    drop.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); fileIn.click(); } });
    drop.addEventListener("dragover", (e) => { e.preventDefault(); drop.classList.add("over"); });
    drop.addEventListener("dragleave", () => drop.classList.remove("over"));
    drop.addEventListener("drop", (e) => { e.preventDefault(); drop.classList.remove("over"); const f = e.dataTransfer?.files?.[0]; if (f) f.text().then((t) => loadText(t, f.name)); });
    $("[data-example]").addEventListener("click", async () => { say("Loading the airway results…"); const t = await fetch("/data/airway_deseq2_results.csv").then((r) => r.text()); loadText(t, "airway_deseq2_results.csv"); });

    // ── column mapping ───────────────────────────────────────────────────
    const fields: { k: keyof Mapping; name: string; req: boolean }[] = [
      { k: "id", name: "gene ID", req: true }, { k: "symbol", name: "symbol", req: false }, { k: "mean", name: "mean expression", req: false },
      { k: "lfc", name: "log2 fold change", req: true }, { k: "p", name: "p-value", req: false }, { k: "padj", name: "adjusted p", req: true },
    ];
    function renderMap() {
      formatEl.textContent = format ? `Recognised ${format} columns. Change them here if needed.` : "Choose which column is which.";
      mapEl.innerHTML = fields.map((f) => `<label><span>${f.name}${f.req ? "" : " <i class='muted'>(optional)</i>"}</span><select data-m="${f.k}">${f.req ? "" : '<option value="">none</option>'}${columns.map((c) => `<option value="${c.replace(/"/g, "&quot;")}" ${mapping![f.k] === c ? "selected" : ""}>${c || "(unnamed first column)"}</option>`).join("")}</select></label>`).join("");
      mapEl.querySelectorAll<HTMLSelectElement>("select").forEach((s) => s.addEventListener("change", () => { mapping![s.dataset.m as keyof Mapping] = s.value; if (mapping!.lfc && mapping!.padj) { say(""); rebuild(); } }));
    }

    // ── state from the controls ──────────────────────────────────────────
    const thr = (): Thresholds => ({ padj: num("[data-t=padj]", 0.05), lfc: num("[data-t=lfc]", 0), minMean: num("[data-t=minMean]", 0) });
    const num = (s: string, d: number) => { const v = parseFloat($<HTMLInputElement>(s).value); return Number.isFinite(v) ? v : d; };
    const meanInfo = () => {
      const m = mapping?.mean ?? "";
      if (/logcpm/i.test(m)) return { label: "log2 CPM", isLog: true };
      if (/aveexpr/i.test(m)) return { label: "average log2 expression", isLog: true };
      if (/basemean/i.test(m)) return { label: "mean of normalized counts", isLog: false };
      return { label: m || "mean expression", isLog: false };
    };
    function figOpts(kind: "volcano" | "ma"): FigureOpts {
      const mi = meanInfo();
      return {
        kind, widthMm: num("[data-f=width]", 89), heightMm: num("[data-f=height]", 80), fontPt: num("[data-f=font]", 8),
        labels: $<HTMLTextAreaElement>("[data-f=labels]").value.split(/\n|,/).map((s) => s.trim()).filter(Boolean),
        labelTop: num("[data-f=labelTop]", 10), title: $<HTMLInputElement>("[data-f=title]").value.trim() || undefined,
        thresholds: thr(), meanLabel: mi.label, meanIsLog: mi.isLog, showThresholdLines: $<HTMLInputElement>("[data-f=lines]").checked,
      };
    }
    document.querySelectorAll<HTMLInputElement>("[data-t], [data-f]").forEach((el) => el.addEventListener("input", () => rows.length && redraw()));

    // ── build rows, then draw ────────────────────────────────────────────
    let symbolTable: Record<string, string> | null = null;
    async function addSymbols() {
      const sample = rows.slice(0, 200);
      const haveSym = sample.some((r) => r.symbol);
      const human = sample.filter((r) => /^ENSG\d+/.test(r.id)).length > sample.length / 2;
      const mouse = sample.filter((r) => /^ENSMUSG\d+/.test(r.id)).length > sample.length / 2;
      if (haveSym) return;
      if (!human && !sample.some((r) => /[A-Za-z]{2,}\d|^\d+$/.test(r.id))) return;   // IDs that already read as symbols
      if (!human) { offerSymbols(); return; }
      try {
        symbolTable ??= await fetch("/data/symbols_human.json").then((r) => r.json());
        let n = 0;
        for (const r of rows) { const s = symbolTable![r.id.replace(/\..*$/, "")]; if (s) { r.symbol = s; n++; } }
        say(`${status.textContent} Added gene symbols for ${n.toLocaleString("en-US")} Ensembl IDs (HGNC, else org.Hs.eg.db).`);
        redraw();
      } catch { /* leave IDs as labels */ }
    }
    // other organisms / Entrez IDs: symbols from g:Profiler, only when asked (the IDs leave the browser)
    function offerSymbols() {
      const box = $<HTMLElement>("[data-sym]");
      const org = organism || organismFrom("", rows.map((r) => r.id));
      box.hidden = false;
      box.innerHTML = `Gene IDs without symbols. <label>Organism <select data-sym-org>${organisms.map(([v, n]) => `<option value="${v}" ${v === org ? "selected" : ""}>${n}</option>`).join("")}</select></label> <button type="button" class="btn btn-ghost" data-sym-go>Add gene symbols (g:Profiler)</button><span class="muted"> sends the gene IDs only</span>`;
      box.querySelector("[data-sym-go]")!.addEventListener("click", async (e) => {
        const b = e.currentTarget as HTMLButtonElement; b.disabled = true; b.textContent = "Looking up…";
        try {
          const o = box.querySelector<HTMLSelectElement>("[data-sym-org]")!.value; organism = o;
          const m = await toSymbols(o, rows.map((r) => r.id.replace(/\.\d+$/, "")));
          let n = 0; for (const r of rows) { const sy = m[r.id.replace(/\.\d+$/, "")]; if (sy) { r.symbol = sy; n++; } }
          box.innerHTML = `Added symbols for ${n.toLocaleString("en-US")} of ${rows.length.toLocaleString("en-US")} genes (g:Profiler g:Convert, ${o}).`;
          redraw();
        } catch (err) { b.disabled = false; b.textContent = "Add gene symbols (g:Profiler)"; box.append(` Failed: ${(err as Error).message}`); }
      });
    }
    function rebuild() {
      const r = toRows(columns, data, mapping!);
      rows = r.rows;
      addSymbols();
      const mi = meanInfo();
      $("[data-mean-name]").textContent = mi.label;
      $("[data-mean-th]").textContent = mapping!.mean || "mean";
      if (r.nDropped) say(`${status.textContent} ${r.nDropped.toLocaleString("en-US")} rows without a fold change were skipped.`);
      redraw();
      if (rows.length) markDone(3, $<HTMLAnchorElement>("[data-enrich]"));
    }
    const plots: Record<string, { c: HTMLCanvasElement; ctx: CanvasRenderingContext2D; tip: ReturnType<typeof tooltip>; pts: { r: Row; x: number; y: number; cls: string }[] }> = {};
    function redraw() {
      const t = thr();
      const cls = rows.map((r) => classify(r, t));
      const tested = rows.filter((r) => Number.isFinite(r.padj)).length;
      const nUp = cls.filter((c) => c === "up").length, nDown = cls.filter((c) => c === "down").length;
      $("[data-stats]").innerHTML = [[rows.length, "genes in file"], [tested, "with an adjusted p"], [nUp, "up"], [nDown, "down"]].map(([v, l]) => `<div class="stat"><b>${(v as number).toLocaleString("en-US")}</b><span>${l}</span></div>`).join("");
      drawPreview("volcano", cls); drawPreview("ma", cls);
      const capV = figureCaption(rows, figOpts("volcano"), sourceName || "this study"), capM = figureCaption(rows, figOpts("ma"), sourceName || "this study");
      $("[data-caption=volcano]").textContent = capV; $("[data-caption=ma]").textContent = capM;
      const crit = `an adjusted p-value below ${t.padj}${t.lfc > 0 ? ` and an absolute log2 fold change above ${t.lfc}` : ""}${t.minMean > 0 ? ` and ${meanInfo().label} of at least ${t.minMean}` : ""}`;
      const methodsSentence = `Of ${tested.toLocaleString("en-US")} genes with an adjusted p-value, ${(nUp + nDown).toLocaleString("en-US")} were considered differentially expressed (${crit}; Benjamini–Hochberg adjustment), of which ${nUp.toLocaleString("en-US")} were up-regulated and ${nDown.toLocaleString("en-US")} down-regulated.`;
      $("[data-papertext]").innerHTML = `<h4>Figure legend, volcano</h4><p>${esc(capV)}</p><h4>Figure legend, MA plot</h4><p>${esc(capM)}</p><h4>Results / methods sentence</h4><p>${esc(methodsSentence)}</p>`;
      $<HTMLAnchorElement>("[data-methods-link]").href = `../methods/?padj=${t.padj}&lfc=${t.lfc}`;
      // table
      const sig = rows.map((r, i) => ({ r, c: cls[i] })).filter((x) => x.c !== "ns").sort((a, b) => a.r.padj - b.r.padj);
      const tb = $<HTMLTableSectionElement>("[data-table] tbody");
      tb.innerHTML = sig.slice(0, 50).map(({ r, c }) => `<tr><td><code>${esc(r.id)}</code></td><td>${esc(r.symbol)}</td><td class="num">${fmtNum(r.mean)}</td><td class="num" style="color:${c === "up" ? "var(--up)" : "var(--down)"}">${r.lfc > 0 ? "+" : ""}${r.lfc.toFixed(2)}</td><td class="num">${fmtNum(r.p)}</td><td class="num">${fmtNum(r.padj)}</td><td>${c}</td></tr>`).join("");
      $("[data-tablenote]").textContent = sig.length > 50 ? `Showing the 50 most significant of ${sig.length.toLocaleString("en-US")}; the CSV has all of them.` : `${sig.length} genes.`;
    }
    function drawPreview(kind: "volcano" | "ma", cls: string[]) {
      const root = $<HTMLElement>(`[data-plot="${kind}"]`);
      const W = 680, H = 440, m = { l: 62, r: 20, t: 16, b: 50 };
      if (!plots[kind]) { const { c, ctx } = canvas(root, W, H); const tip = tooltip(root); plots[kind] = { c, ctx, tip, pts: [] };
        c.addEventListener("pointermove", (e) => { const p = plots[kind]; const b = p.c.getBoundingClientRect(), sx = W / b.width, mx = (e.clientX - b.left) * sx, my = (e.clientY - b.top) * sx; let best = null as typeof p.pts[number] | null, bd = 64; for (const q of p.pts) { const d = (q.x - mx) ** 2 + (q.y - my) ** 2; if (d < bd && (q.cls !== "ns" || d < 16)) { bd = d; best = q; } } if (!best) { p.tip.hide(); return; } const r = best.r; p.tip.show(`<b>${esc(label(r))}</b>${r.symbol ? ` <span style="opacity:.7">${esc(r.id)}</span>` : ""}<br>log2FC ${r.lfc.toFixed(2)} · mean ${fmt(r.mean, 1)}<br>p ${fmt(r.p)} · padj ${fmt(r.padj)}`, e.clientX, e.clientY); });
        c.addEventListener("pointerleave", () => plots[kind].tip.hide()); }
      const p = plots[kind], ctx = p.ctx, mi = meanInfo(), t = thr();
      const xv = (r: Row) => (kind === "volcano" ? r.lfc : mi.isLog ? r.mean : Math.log10(Math.max(r.mean, 0.01)));
      const yv = (r: Row) => (kind === "volcano" ? -Math.log10(Math.max(r.padj, 1e-300)) : r.lfc);
      const xs = rows.map(xv).filter(Number.isFinite), ys = rows.map(yv).filter(Number.isFinite);
      let x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = kind === "volcano" ? 0 : Math.min(...ys), y1 = Math.max(...ys);
      if (kind === "volcano") { const a = Math.max(Math.abs(x0), Math.abs(x1)); x0 = -a - 0.3; x1 = a + 0.3; y1 = Math.min(y1 + 3, 320); } else { y0 -= 0.3; y1 += 0.3; }
      const x = linear([x0, x1], [m.l, W - m.r]), y = linear([y0, y1], [H - m.b, m.t]);
      ctx.clearRect(0, 0, W, H);
