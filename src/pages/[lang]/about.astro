---
import Base from "../../layouts/Base.astro";
import { langs, t, type Lang } from "../../i18n/ui";
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const GH = "https://github.com/codingGrassLab";
const REPO = "https://github.com/codingGrassLab/reads-to-results";
const s = {
  en: {
    who: "Who made this",
    whoAfter: ", a biochemistry and molecular biology student and researcher at Shahjalal University of Science and Technology, Bangladesh, whose research work is RNA-seq analysis.",
    why: "Why it exists",
    whyText: "Most RNA-seq tutorials either show code without the output, or output without the code. Students then cannot tell whether their own result looks right. This site shows both, on one real dataset, so that a student anywhere can follow a complete analysis and check their understanding against real numbers.",
    what: "What it is not",
    whatText: "It does not run Salmon or DESeq2 for you: you run them on your own computer, following the lessons. It is also not a substitute for the documentation of DESeq2, Salmon or the other software it describes; those documents are linked from each lesson and should be read.",
    contact: "Corrections",
    contactText: "If a number or a sentence is wrong, please",
    contactLink: "open an issue on GitHub",
  },
}[lang];
---
<Base lang={lang} title={t(lang, "about.title")} active="about">
  <div class="container prose">
    <div class="page-head"><h1>{t(lang, "about.title")}</h1></div>
    <h2>{s.who}</h2>
    <p>Reads to Results is written and maintained by <a class="author" href={GH} rel="author">Amarta Chowdhury</a>{s.whoAfter}</p>
    <p><a class="gh" href={GH}><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg><span>github.com/<b>codingGrassLab</b></span><span class="arrow" aria-hidden="true">→</span></a></p>
    <h2>{s.why}</h2><p>{s.whyText}</p>
    <h2>{s.what}</h2><p>{s.whatText}</p>
    <h2>{s.contact}</h2><p>{s.contactText} <a href={`${REPO}/issues`}>{s.contactLink}</a>.</p>
  </div>
  <style>
    .author { font-weight: 600; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
    .gh { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.55rem 1rem; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--surface); color: var(--ink); text-decoration: none; font-size: 0.95rem; transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s; }
    .gh:hover { border-color: var(--ink); box-shadow: var(--shadow); transform: translateY(-1px); color: var(--ink); }
    .gh b { font-weight: 600; }
    .gh .arrow { color: var(--muted); transition: transform 0.2s; }
    .gh:hover .arrow { transform: translateX(3px); color: var(--ink); }
  </style>
</Base>
