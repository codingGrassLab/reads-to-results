---
import Base from "../../../layouts/Base.astro";
import LessonList from "../../../components/LessonList.astro";
import { langs, t, type Lang } from "../../../i18n/ui";
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} title={t(lang, "read.title")} description={t(lang, "read.lead")} active="read">
  <div class="container">
    <div class="page-head prose"><h1>{t(lang, "read.title")}</h1><p class="lead">{t(lang, "read.lead")}</p></div>
    <LessonList coll="read" lang={lang} />
  </div>
</Base>
