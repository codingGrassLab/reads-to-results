---
import Base from "../../layouts/Base.astro";
import { langs, path, type Lang } from "../../i18n/ui";
import { algorithms } from "../../scripts/hub.mjs";
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const title = "Hub genes";
const description = "Build the protein–protein interaction network of your DE genes with STRING (or upload one), rank the nodes with the twelve cytoHubba scores, pick the top N, and get the hub table, the network figure and files that open in Cytoscape.";
const algoHelp: Record<string, string> = {
  Degree: "number of neighbours", MCC: "maximal clique centrality: sum of (|C|−1)! over the maximal cliques containing the node; cytoHubba's best-performing score", DMNC: "density of the maximum neighbourhood component", MNC: "size of the largest connected component among the node's neighbours", EPC: "edge-percolated component: mean size of the node's component over 1,000 random removals of half the edges", BottleNeck: "how often the node is a bottleneck in shortest-path trees (subtree larger than n/4)", EcCentricity: "1 / the longest shortest path from the node", Closeness: "sum of 1 / distance to every other node", Radiality: "(diameter + 1 − mean distance) style reach", Betweenness: "number of shortest paths passing through the node", Stress: "number of shortest paths passing through the node, counting all paths", ClusteringCoefficient: "how connected the node's neighbours are to each other",
};
---
<Base lang={lang} title={title} description={description} active="hub">
  <div class="container">
    <div class="page-head prose">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <p class="small muted">The scores are computed in your browser; an uploaded network file is not sent anywhere. Scores follow cytoHubba's definitions and were checked against networkx on random graphs (see the data page).</p>
    </div>

    <section class="hb-degs" data-degs hidden>
      <h2>Your DE genes → STRING network → hub genes</h2>
      <p class="small" data-degs-info></p>
      <div class="hb-degrow">
        <label>Top <input type="number" data-degs-n min="10" value="300" style="width:5.5rem;display:inline-block" /> genes by adjusted p</label>
        <label>Confidence <select data-conf><option value="400">medium, ≥ 0.4 (STRING default)</option><option value="700">high, ≥ 0.7</option><option value="900">highest, ≥ 0.9</option><option value="150">low, ≥ 0.15</option></select></label>
        <label>Network <select data-ntype><option value="functional">full (functional + physical)</option><option value="physical">physical only</option></select></label>
      </div>
      <div class="hb-degrow">
        <button type="button" class="btn btn-primary" data-build>Build the network with STRING</button>
        <form method="post" action="https://string-db.org/cgi/network" target="_blank" data-string><input type="hidden" name="identifiers" /><input type="hidden" name="species" /><button type="submit" class="btn btn-ghost">Open them on string-db.org ↗</button></form>
        <button type="button" class="btn btn-ghost" data-degs-copy>Copy the list</button>
        <button type="button" class="btn btn-ghost" data-degs-dl>genes.txt</button>
        <button type="button" class="btn btn-ghost" data-net-dl hidden>STRING network TSV</button>
      </div>
      <p class="small" data-build-status></p>
      <p class="small muted" data-degs-note></p>
      <p class="small muted">The gene names and the organism are sent to the STRING API (string-db.org, data CC BY 4.0) when the network is built; nothing else. Cite STRING (Szklarczyk et al. 2023) with the version shown.</p>
    </section>

    <section>
      <div class="drop" data-drop tabindex="0" role="button" aria-label="Choose or drop a network file">
        <input type="file" accept=".tsv,.txt,.csv,.sif" data-file hidden />
        <strong>Drop the network file here, or click to choose</strong>
        <span class="muted small">STRING: on your network page choose <em>Exports → … as simple tabular text output (TSV)</em>. Any two-column edge list (TSV/CSV/SIF) also works.</span>
      </div>
      <div class="rt-or"><span>or</span><button type="button" class="btn btn-ghost" data-example>Try with an example network</button></div>
      <p class="rt-status small muted" data-status></p>
    </section>

    <section class="hb" data-main hidden>
      <div class="hb-side">
        <div class="box">
          <h3>Ranking</h3>
          <label>Score <select data-algo>{algorithms.map((a) => <option value={a} selected={a === "MCC"}>{a}</option>)}</select></label>
          <p class="small muted" data-algohelp></p>
          <label>Top N hub genes <input type="number" data-n value="10" min="1" max="100" /></label>
          <label class="chk"><input type="checkbox" data-labels checked /> show gene names</label>
          <label>Node colour <select data-colour><option value="rank">rank (red = 1 → yellow = N)</option><option value="lfc">log2 fold change (up red, down blue)</option></select></label>
          <label>Layout <select data-layout><option value="cose">force-directed (cose)</option><option value="circle">circle</option><option value="concentric">concentric by rank</option><option value="grid">grid</option></select></label>
        </div>
        <div class="box">
          <h3>Export</h3>
          <div class="hb-btns">
            <button class="btn btn-primary" data-dl="png">Figure PNG (3×)</button>
            <button class="btn btn-ghost" data-dl="top">Top N table CSV</button>
            <button class="btn btn-ghost" data-dl="all">All scores CSV</button>
            <button class="btn btn-ghost" data-dl="sif">Network SIF (Cytoscape)</button>
            <button class="btn btn-ghost" data-dl="attrs">Node attributes CSV (Cytoscape)</button>
          </div>
          <p class="small muted">In Cytoscape: File → Import → Network from File (the SIF), then File → Import → Table from File (the attributes CSV) to colour and size nodes by any score.</p>
        </div>
      </div>
      <div class="hb-body">
        <div class="stats" data-stats></div>
        <div class="hb-fig"><div data-cy class="hb-cy"></div><div class="legend" data-legend></div></div>
        <p class="caption" data-caption></p>
        <h2 style="margin-top:2rem">Top <span data-n-out>10</span> hub genes by <span data-algo-out>MCC</span></h2>
        <div class="table-wrap"><table class="hb-table"><thead><tr><th>Rank</th><th>Gene</th><th class="num" data-score-th>MCC</th><th>Ranks in the other scores</th></tr></thead><tbody data-table></tbody></table></div>
        <h2 style="margin-top:2.5rem">Consensus across scores</h2>
        <p class="small muted">Pick several scores; each gives its own top N list (N above). Genes found by every chosen score are the consensus hubs; the Venn (2–3 scores) or UpSet plot (more) shows how the lists overlap.</p>
        <div class="hb-cons">
          <div class="hb-algos" data-cons-algos>{algorithms.map((a) => <label class="chk"><input type="checkbox" value={a} checked={["MCC", "Degree", "Betweenness", "Closeness"].includes(a)} /> {a}</label>)}</div>
          <div class="hb-btns" style="margin:0.6rem 0"><button class="btn btn-ghost" data-cdl="svg">Overlap figure SVG</button><button class="btn btn-ghost" data-cdl="png">PNG 300 dpi</button><button class="btn btn-ghost" data-cdl="consensus">Consensus genes CSV</button><button class="btn btn-ghost" data-cdl="matrix">Membership matrix CSV</button></div>
          <div class="hb-venn" data-venn></div>
          <p class="caption" data-cons-caption></p>
          <div class="table-wrap"><table class="hb-table"><thead><tr><th>Gene</th><th class="num">in how many lists</th><th>which scores</th></tr></thead><tbody data-cons-table></tbody></table></div>
        </div>

        <div class="note small"><strong>What a hub is and is not.</strong> A hub is a node that is central in this network, nothing more. STRING networks over-represent well-studied genes, so hubs are often simply famous genes. Treat the list as candidates, show their fold changes and adjusted p-values next to the scores, and say which score and which cutoff you used.</div>
      </div>
    </section>
  </div>

  <style>
    .drop { border: 2px dashed var(--line-strong); border-radius: var(--radius); padding: 2rem 1.5rem; text-align: center; background: var(--surface); cursor: pointer; display: flex; flex-direction: column; gap: 0.5rem; align-items: center; }
    .drop:hover, .drop.over { border-color: var(--accent); background: var(--accent-soft); }
    .rt-or { display: flex; align-items: center; gap: 1rem; margin: 1rem 0 0.5rem; } .rt-or span { color: var(--dim); font-size: 0.9rem; }
    .rt-status:empty { display: none; } .rt-status.err { color: var(--up); }
    .hb { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 2rem; align-items: start; margin-top: 2rem; }
    @media (max-width: 900px) { .hb { grid-template-columns: 1fr; } }
    .hb-side { display: flex; flex-direction: column; gap: 1rem; }
    .box { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.9rem 1rem 1rem; }
    .box h3 { margin: 0 0 0.5rem; font-size: 1.05rem; }
    .box label { display: block; font-size: 0.86rem; color: var(--muted); margin: 0.5rem 0; }
    .box input:not([type="checkbox"]), .box select { display: block; width: 100%; margin-top: 0.2rem; padding: 0.35rem 0.5rem; font: inherit; font-size: 0.92rem; color: var(--ink); background: var(--bg); border: 1px solid var(--line-strong); border-radius: 6px; }
    .box label.chk { display: flex; gap: 0.5rem; align-items: center; } .box label.chk input { margin: 0; }
    .hb-btns { display: flex; flex-wrap: wrap; gap: 0.4rem; } .hb-btns .btn { font-size: 0.82rem; padding: 0.4rem 0.8rem; }
    .hb-fig { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.4rem; }
    .hb-cy { width: 100%; height: 460px; }
    .legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; font-size: 0.85rem; color: var(--muted); padding: 0.4rem 0.6rem 0.2rem; }
    :global(.legend i) { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 0.4rem; }
    .caption { font-size: 0.88rem; color: var(--muted); user-select: all; }
    .hb-table td { font-size: 0.86rem; } .hb-table td.r { color: var(--dim); font-size: 0.76rem; }
    .hb-algos { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.2rem 0.8rem; font-size: 0.86rem; color: var(--muted); }
    .hb-algos label { display: flex; gap: 0.4rem; align-items: center; }
    .hb-venn { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.5rem; max-width: 620px; }
    .hb-venn svg { width: 100%; height: auto; }
    .btn.flash { background: var(--accent); color: #fff; }
    .hb-degs { border: 1px solid var(--accent); background: var(--accent-soft); border-radius: var(--radius); padding: 1rem 1.3rem 0.6rem; margin-bottom: 1.5rem; }
    .hb-degs h2 { margin: 0 0 0.3rem; font-size: 1.25rem; }
    .hb-degrow { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin: 0.6rem 0; }
    .hb-degrow label { font-size: 0.88rem; color: var(--muted); }
    .hb-degrow input { padding: 0.3rem 0.5rem; font: inherit; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--bg); }
    .hb-degrow form { margin: 0; }
    .hb-steps { margin: 0.4rem 0 0.6rem 1.2rem; padding: 0; color: var(--text); } .hb-steps li { margin: 0.2rem 0; }
  </style>

  <script>
    import cytoscape from "cytoscape";
    import { parseNetwork, buildGraph, scoreAll, rank, algorithms } from "../../scripts/hub.mjs";
    import { download, svgToPng } from "../../scripts/deg";
    import { vennSVG, upsetSVG, regions } from "../../scripts/venn";
    import { toSymbols } from "../../scripts/enrich";
    import { markDone, resetFrom } from "../../scripts/flow";
    const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
    const algoHelp: Record<string, string> = JSON.parse(document.getElementById("algo-help")!.textContent!);
    const drop = $<HTMLElement>("[data-drop]"), fileIn = $<HTMLInputElement>("[data-file]"), status = $<HTMLElement>("[data-status]"), main = $<HTMLElement>("[data-main]");
    const say = (m: string, err = false) => { status.textContent = m; status.classList.toggle("err", err); };
    let rawText = "", sourceName = "", net: any = null, g: any = null, scores: any = null, cy: any = null;

    async function loadText(text: string, name: string) {
      rawText = text; sourceName = name; resetFrom(5);
      try { rebuild(); main.hidden = false; markDone(5); } catch (e) { say((e as Error).message, true); }
    }

    // ── DE genes handed over from the results / enrichment steps ──
    const lfcOf: Record<string, number> = {};
    let netMeta: { version: string; conf: number; type: string; sent: number } | null = null, stringTSV: { name: string; text: string } | null = null;
    const STRING = "https://string-db.org/api";
    const pause = (ms: number) => new Promise((r) => setTimeout(r, ms));
    async function stringPost(path: string, params: Record<string, string>) {
      const r = await fetch(`${STRING}/${path}`, { method: "POST", body: new URLSearchParams({ ...params, caller_identity: "reads-to-results" }) });
      if (!r.ok) throw new Error(`STRING returned ${r.status}`);
      return r.text();
    }
    /** Map the genes to STRING proteins (best match each), then fetch the interactions among them. */
    async function stringNetwork(genes: string[], species: number, conf: number, type: string) {
      const version = await fetch(`${STRING}/json/version`).then((r) => r.json()).then((j) => j[0]?.string_version ?? "").catch(() => "");
      const ids = await stringPost("tsv/get_string_ids", { identifiers: genes.join("\r"), species: String(species), limit: "1", echo_query: "1" });
      const rows = ids.trim().split("\n").slice(1).map((l) => l.split("\t"));
      const mapped = new Map<string, string>(); for (const r of rows) if (r[0] && r[2] && !mapped.has(r[0])) mapped.set(r[0], r[2]);
      const missing = genes.filter((gn) => !mapped.has(gn));
      if (!mapped.size) throw new Error("none of the genes were found in STRING for this organism");
      await pause(1000);   // STRING asks for a second between calls
      const tsv = await stringPost("tsv/network", { identifiers: [...new Set(mapped.values())].join("\r"), species: String(species), required_score: String(conf), network_type: type });
      const lines = tsv.trim().split("\n").slice(1).filter(Boolean);
      const conn = new Set<string>(); for (const l of lines) { const f = l.split("\t"); conn.add(f[2]); conn.add(f[3]); }
      return { tsv, version, found: mapped.size, missing, edges: new Set(lines.map((l) => { const f = l.split("\t"); return [f[2], f[3]].sort().join("|"); })).size, connected: conn.size };
    }
    const taxon: Record<string, number> = { hsapiens: 9606, mmusculus: 10090, rnorvegicus: 10116, drerio: 7955, dmelanogaster: 7227, celegans: 6239, scerevisiae: 4932, athaliana: 3702, ggallus: 9031, sscrofa: 9823, btaurus: 9913 };
    (async () => {
      let ids: string[] = [], syms: Record<string, string> = {}, organism = "", src = "";
      try {
        const d = sessionStorage.getItem("rr-degs"), h = sessionStorage.getItem("rr-hub");
        const hub = h ? JSON.parse(h) : null, degs = d ? JSON.parse(d) : null;
        if (degs?.degs?.length) { ids = degs.degs.map((x: any[]) => x[0]); degs.degs.forEach((x: any[]) => { if (x[1]) syms[x[0]] = x[1]; }); organism = degs.organism || ""; src = `${degs.source}, sorted by adjusted p`; }
        if (hub) { organism = hub.organism || organism; if (!ids.length) { ids = [...hub.up, ...hub.down]; src = "the enrichment lists"; } }
      } catch {}
      if (!ids.length) return;
      const box = $<HTMLElement>("[data-degs]"); box.hidden = false;
      const nIn = $<HTMLInputElement>("[data-degs-n]"); nIn.value = String(Math.min(ids.length, 300)); nIn.max = String(ids.length);
      $("[data-degs-info]").textContent = `${ids.length.toLocaleString("en-US")} differentially expressed genes from ${src}${organism ? ` · ${organism}` : ""}.`;
      // STRING resolves symbols best: look them up for IDs that have none (the same IDs already went to g:Profiler in the enrichment step)
      const need = ids.filter((i) => !syms[i]);
      if (need.length && organism) {
        $("[data-degs-note]").textContent = "Looking up gene symbols (g:Profiler)…";
        try { const m = await toSymbols(organism, need); Object.assign(syms, m); const left = ids.filter((i) => !syms[i]).length; $("[data-degs-note]").textContent = `Genes are sent as symbols${Object.keys(m).length ? ` (${Object.keys(m).length.toLocaleString("en-US")} looked up with g:Profiler)` : ""}${left ? `; ${left.toLocaleString("en-US")} IDs without a known symbol are sent as IDs` : ""}.`; }
        catch { $("[data-degs-note]").textContent = "Symbols could not be looked up; the IDs are sent as they are (STRING understands Ensembl and Entrez IDs too)."; }
      }
      const list = () => [...new Set(ids.slice(0, Math.max(1, +nIn.value || 300)).map((i) => syms[i] || i))];
      // log2 fold changes by the names STRING will show
      try { const d = JSON.parse(sessionStorage.getItem("rr-degs") || "null"); for (const x of d?.degs ?? []) { lfcOf[syms[x[0]] || x[0]] = +x[2]; lfcOf[x[0]] = +x[2]; } } catch {}
      if (Object.keys(lfcOf).length) $<HTMLSelectElement>("[data-colour]").value = "lfc";
      const f = $<HTMLFormElement>("[data-string]");
      f.addEventListener("submit", () => { (f.elements.namedItem("identifiers") as HTMLInputElement).value = list().join("\r"); (f.elements.namedItem("species") as HTMLInputElement).value = String(taxon[organism] ?? 9606); });
      if (!taxon[organism]) $("[data-degs-note]").append(" Organism unknown: choose it on string-db.org.");
      $("[data-degs-copy]").addEventListener("click", async (e) => { try { await navigator.clipboard.writeText(list().join("\n")); flash(e.currentTarget as HTMLElement, "Copied"); } catch {} });
      $("[data-degs-dl]").addEventListener("click", (e) => { download("genes.txt", list().join("\n") + "\n", "text/plain"); flash(e.currentTarget as HTMLElement, "Saved"); });
      const bst = $<HTMLElement>("[data-build-status]");
      const build = async () => {
        if (!taxon[organism]) { bst.textContent = "The organism is not known here, so STRING cannot be queried automatically. Use 'Open them on string-db.org' and drop the export below."; return; }
        const genes = list(), conf = +v("[data-conf]"), type = v("[data-ntype]"), btn = $<HTMLButtonElement>("[data-build]");
        btn.disabled = true; bst.textContent = `Asking STRING for ${genes.length} genes…`;
        try {
          const r = await stringNetwork(genes, taxon[organism], conf, type);
          netMeta = { version: r.version, conf, type, sent: genes.length };
          const name = `string_v${r.version}_${organism}_${type}_${conf}.tsv`;
          stringTSV = { name, text: r.tsv };
          $<HTMLElement>("[data-net-dl]").hidden = false;
          bst.innerHTML = `STRING ${esc(r.version)}: <b>${r.found}</b> of ${genes.length} genes found${r.missing.length ? ` (not found: ${esc(r.missing.slice(0, 8).join(", "))}${r.missing.length > 8 ? ", …" : ""})` : ""}; <b>${r.edges.toLocaleString("en-US")}</b> interactions at score ≥ ${conf / 1000} among <b>${r.connected}</b> genes; ${r.found - r.connected} genes had no partner and are left out.`;
          if (!r.edges) { bst.append(" No interactions: lower the confidence or send more genes."); btn.disabled = false; return; }
          await loadText(r.tsv, name);
          setTimeout(() => main.scrollIntoView({ behavior: "smooth", block: "start" }), 50);
        } catch (e) { bst.textContent = `STRING could not be reached: ${(e as Error).message}. Try again, or use string-db.org and upload the export.`; }
        btn.disabled = false;
      };
      $("[data-build]").addEventListener("click", build);
      $("[data-net-dl]").addEventListener("click", (e) => { if (stringTSV) { download(stringTSV.name, stringTSV.text, "text/tab-separated-values"); flash(e.currentTarget as HTMLElement, "Saved"); } });
      // arriving through the workflow's Next button: build it straight away
      if (new URLSearchParams(location.search).get("auto") === "1") setTimeout(build, 0);
    })();
    fileIn.addEventListener("change", () => { const f = fileIn.files?.[0]; if (f) f.text().then((t) => loadText(t, f.name)); });
    drop.addEventListener("click", () => fileIn.click());
    drop.addEventListener("dragover", (e) => { e.preventDefault(); drop.classList.add("over"); }); drop.addEventListener("dragleave", () => drop.classList.remove("over"));
    drop.addEventListener("drop", (e) => { e.preventDefault(); drop.classList.remove("over"); const f = e.dataTransfer?.files?.[0]; if (f) f.text().then((t) => loadText(t, f.name)); });
    $("[data-example]").addEventListener("click", async () => { say("Loading…"); loadText(await fetch("/data/example_string_network.tsv").then((r) => r.text()), "example_string_network.tsv"); });

    const v = (s: string) => $<HTMLInputElement>(s).value;
    function rebuild() {
      net = parseNetwork(rawText);
      g = buildGraph(net.nodes, net.edges);
      const t0 = performance.now();
      scores = scoreAll(g);
      say(`${sourceName}: ${net.format}, ${net.nodes.length} nodes, ${net.edges.length} edges; twelve scores computed in ${((performance.now() - t0) / 1000).toFixed(1)} s.`);
      render(true);
    }
    function render(relayout = false) {
      const algo = v("[data-algo]"), N = Math.max(1, Math.min(parseInt(v("[data-n]")) || 10, g.nodes.length));
      $("[data-algohelp]").textContent = algoHelp[algo] ?? "";
      const order = rank(g, scores, algo), top = order.slice(0, N), topSet = new Set(top);
      const rankOf: Record<string, number[]> = {}; for (const a of algorithms) { const o = rank(g, scores, a); rankOf[a] = new Array(g.nodes.length); o.forEach((v2: number, i: number) => (rankOf[a][v2] = i + 1)); }
      const comps = components(g);
      $("[data-stats]").innerHTML = [[g.nodes.length, "nodes"], [net.edges.length, "edges"], [comps, "connected components"], [scores.diameter, "diameter"], [(2 * net.edges.length / g.nodes.length).toFixed(2), "mean degree"]].map(([a, b]) => `<div class="stat"><b>${a}</b><span>${b}</span></div>`).join("");
      $("[data-n-out]").textContent = String(N); $("[data-algo-out]").textContent = algo; $("[data-score-th]").textContent = algo;
      const fmt = (x: number) => (Number.isInteger(x) ? String(x) : x >= 100 ? x.toFixed(1) : x.toPrecision(3));
      $("[data-table]").innerHTML = top.map((i: number, k: number) => `<tr><td>${k + 1}</td><td><b>${esc(g.nodes[i])}</b></td><td class="num">${fmt(scores[algo][i])}</td><td class="r">${algorithms.filter((a) => a !== algo).map((a) => `${a} ${rankOf[a][i]}`).join(" · ")}</td></tr>`).join("");
      $("[data-caption]").textContent = `Top ${N} hub genes of a protein–protein interaction network of ${g.nodes.length} genes and ${net.edges.length} interactions, ranked by ${algo} as defined in cytoHubba. ${netMeta ? `The network is STRING ${netMeta.version} (${netMeta.type === "physical" ? "physical" : "full"} network, interaction score ≥ ${netMeta.conf / 1000}) for the top ${netMeta.sent} differentially expressed genes by adjusted p-value. ` : ""}${v("[data-colour]") === "lfc" && Object.keys(lfcOf).length ? "Nodes are coloured by log2 fold change (red up, blue down)" : `Nodes are coloured from red (rank 1) to yellow (rank ${N})`}, node size is proportional to the ${algo} score, and edges are the interactions among these ${N} genes${net.hasScore ? ", with width proportional to the STRING combined score" : ""}. Top ${N}: ${top.map((i: number) => g.nodes[i]).join(", ")}.`;
      // network view
      const labels = $<HTMLInputElement>("[data-labels]").checked;
      const show = topSet;   // the viewer shows the top N and the interactions among them, as cytoHubba does
      const sMax = Math.max(...scores[algo]) || 1, sMin = Math.min(...scores[algo]);
      const byLfc = v("[data-colour]") === "lfc" && Object.keys(lfcOf).length > 0;
      const mix = (a: number[], b: number[], t: number) => `rgb(${a.map((c, j) => Math.round(c + (b[j] - c) * t)).join(",")})`;
      const col = (k: number, name: string) => {
        if (byLfc) { const l = lfcOf[name]; if (l === undefined) return "#d9dddc"; return mix([238, 238, 238], l > 0 ? [192, 57, 43] : [44, 95, 168], Math.min(1, 0.3 + 0.7 * Math.abs(l) / 6)); }
        return mix([192, 57, 43], [246, 213, 92], N > 1 ? k / (N - 1) : 0);
      };
      $("[data-legend]").innerHTML = byLfc
        ? `<span><i style="background:#c0392b"></i>up-regulated</span><span><i style="background:#2c5fa8"></i>down-regulated</span><span class="muted">darker = larger |log2FC| (full colour at 6); node size = ${esc(algo)} score; edge width = STRING confidence</span>`
        : `<span><i style="background:#c0392b"></i>rank 1</span><span><i style="background:#f6d55c"></i>rank N</span><span class="muted">top N hub genes and the interactions between them; node size = chosen score${net.hasScore ? "; edge width = confidence" : ""}</span>`;
      const els: any[] = [];
      g.nodes.forEach((name: string, i: number) => { if (!show.has(i)) return; const k = top.indexOf(i); els.push({ data: { id: String(i), label: name, color: k >= 0 ? col(k, name) : "#d9dddc", size: 22 + 26 * ((scores[algo][i] - sMin) / (sMax - sMin || 1)), hub: k >= 0 ? 1 : 0, zi: k >= 0 ? 10 : 1 } }); });
      net.edges.forEach(([a, b, sc]: [string, string, number | null], j: number) => { const ia = g.idx.get(a), ib = g.idx.get(b); if (show.has(ia) && show.has(ib)) els.push({ data: { id: `e${j}`, source: String(ia), target: String(ib), hubEdge: topSet.has(ia) && topSet.has(ib) ? 1 : 0, w: sc == null ? 2 : 0.8 + 3.2 * Math.max(0, (sc - 0.15) / 0.85) } }); });
      if (!cy) {
        cy = cytoscape({ container: $("[data-cy]"), elements: els, style: [
          { selector: "node", style: { "background-color": "data(color)", width: "data(size)", height: "data(size)", label: labels ? "data(label)" : "", "font-size": 12, "font-family": "Arial, Helvetica, sans-serif", "text-valign": "bottom", "text-halign": "center", "text-margin-y": 3, "text-background-color": "#ffffff", "text-background-opacity": 0.85, "text-background-padding": "1px", "text-background-shape": "roundrectangle", "border-width": 1, "border-color": "#333", "z-index": "data(zi)" } },
          { selector: "node[hub = 1]", style: { "font-weight": "bold", "font-size": 11 } },
          { selector: "edge", style: { width: "data(w)", "line-color": "#9aa39f", "curve-style": "haystack", opacity: 0.85 } },
        ], layout: { name: v("[data-layout]"), animate: false, padding: 30, ...coseOpts } as any, wheelSensitivity: 0.2 });
      } else {
        cy.elements().remove(); cy.add(els); cy.style().selector("node").style("label", labels ? "data(label)" : "").update();
        if (relayout) cy.layout({ name: v("[data-layout]"), animate: false, padding: 30, ...coseOpts, ...(v("[data-layout]") === "concentric" ? { concentric: (n: any) => n.data("hub") ? 2 : 1, levelWidth: () => 1 } : {}) } as any).run();
      }
      if (relayout) cy.fit(undefined, 20);
      (window as any).__hub = { net, g, scores, top: top.map((i: number) => g.nodes[i]), algo, N };
      renderConsensus();
    }
    const coseOpts = { nodeRepulsion: () => 12000, idealEdgeLength: () => 90, nodeOverlap: 40, randomize: false, componentSpacing: 60 };
    // consensus across several scores
    let consSvg = "", consW = 120, consH = 80;
    function renderConsensus() {
      if (!g) return;
      const N = Math.max(1, Math.min(parseInt(v("[data-n]")) || 10, g.nodes.length));
      const chosen = Array.from(document.querySelectorAll<HTMLInputElement>("[data-cons-algos] input:checked")).map((c) => c.value);
      const sets = chosen.map((a) => ({ name: a, items: rank(g, scores, a).slice(0, N).map((i: number) => g.nodes[i] as string) }));
      const venn = $<HTMLElement>("[data-venn]"), tb = $<HTMLElement>("[data-cons-table]"), cap = $<HTMLElement>("[data-cons-caption]");
      if (sets.length < 2) { venn.innerHTML = `<p class="muted small" style="margin:.5rem">Tick at least two scores.</p>`; tb.innerHTML = ""; cap.textContent = ""; consSvg = ""; return; }
      const o = { widthMm: 120, fontPt: 8, title: `Top ${N} hub genes by ${sets.length} scores` };
      consSvg = sets.length <= 3 ? vennSVG(sets, o) : upsetSVG(sets, o);
      const m = consSvg.match(/height="([\d.]+)mm"/); consW = 120; consH = m ? parseFloat(m[1]) : 80;
      venn.innerHTML = consSvg;
      const reg = regions(sets), all = (1 << sets.length) - 1, consensus = reg.get(all) ?? [];
      const rows: { gene: string; k: number; which: string[] }[] = [];
      for (const [mask, items] of reg) { const which = sets.filter((_, i) => mask & (1 << i)).map((x) => x.name); for (const gene of items) rows.push({ gene, k: which.length, which }); }
      rows.sort((a, b) => b.k - a.k || a.gene.localeCompare(b.gene));
      tb.innerHTML = rows.map((r) => `<tr${r.k === sets.length ? ' style="background:var(--accent-soft)"' : ""}><td><b>${esc(r.gene)}</b></td><td class="num">${r.k} / ${sets.length}</td><td class="r">${r.which.join(" · ")}</td></tr>`).join("");
      cap.textContent = `Overlap of the top ${N} hub genes ranked by ${sets.map((x) => x.name).join(", ")} (cytoHubba definitions). ${consensus.length} gene${consensus.length === 1 ? "" : "s"} ${consensus.length === 1 ? "is" : "are"} found by all ${sets.length} scores${consensus.length ? `: ${consensus.join(", ")}` : ""}.`;
      (window as any).__cons = { sets, consensus, rows };
    }
    document.querySelectorAll<HTMLInputElement>("[data-cons-algos] input").forEach((c) => c.addEventListener("change", renderConsensus));
    document.querySelectorAll<HTMLButtonElement>("[data-cdl]").forEach((b) => b.addEventListener("click", async () => {
      const c = (window as any).__cons; if (!c || !consSvg) return;
      const N = parseInt(v("[data-n]")) || 10, stem = `hub_consensus_top${N}_${c.sets.map((x: any) => x.name).join("-")}`;
      if (b.dataset.cdl === "svg") download(`${stem}.svg`, consSvg, "image/svg+xml");
      if (b.dataset.cdl === "png") { b.textContent = "Rendering…"; try { download(`${stem}_300dpi.png`, await svgToPng(consSvg, consW, consH, 300)); } catch { flash(b, "Failed"); return; } }
      if (b.dataset.cdl === "consensus") download(`${stem}_consensus.csv`, ["gene,in_lists,of_lists,scores", ...c.rows.filter((r: any) => r.k === c.sets.length).map((r: any) => `${csvEsc(r.gene)},${r.k},${c.sets.length},${csvEsc(r.which.join(";"))}`)].join("\n") + "\n", "text/csv");
      if (b.dataset.cdl === "matrix") download(`${stem}_membership.csv`, ["gene," + c.sets.map((x: any) => x.name).join(",") + ",in_lists", ...c.rows.map((r: any) => `${csvEsc(r.gene)},${c.sets.map((x: any) => (r.which.includes(x.name) ? 1 : 0)).join(",")},${r.k}`)].join("\n") + "\n", "text/csv");
      flash(b, "Saved");
    }));
    function components(gr: any) { const seen = new Array(gr.nodes.length).fill(false); let c = 0; for (let s = 0; s < gr.nodes.length; s++) { if (seen[s]) continue; c++; const st = [s]; seen[s] = true; while (st.length) { const x = st.pop()!; for (const y of gr.adj[x]) if (!seen[y]) { seen[y] = true; st.push(y); } } } return c; }
    const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
    $("[data-algo]").addEventListener("change", () => render(true)); $("[data-n]").addEventListener("input", () => render(true));
    $("[data-labels]").addEventListener("change", () => render(false)); $("[data-colour]").addEventListener("change", () => render(false)); $("[data-layout]").addEventListener("change", () => render(true));

    const flash = (b: HTMLElement, t: string) => { const o = b.textContent; b.textContent = t; b.classList.add("flash"); setTimeout(() => { b.textContent = o; b.classList.remove("flash"); }, 1500); };
    const csvEsc = (s: string) => (/[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s);
    document.querySelectorAll<HTMLButtonElement>("[data-dl]").forEach((b) => b.addEventListener("click", () => {
      if (!g) return; const algo = v("[data-algo]"), N = parseInt(v("[data-n]")) || 10, order = rank(g, scores, algo), top = order.slice(0, N);
      const stem = `hub_${algo}_top${N}`;
      const header = ["gene", ...algorithms].join(",");
      const row = (i: number) => [csvEsc(g.nodes[i]), ...algorithms.map((a) => scores[a][i])].join(",");
      if (b.dataset.dl === "top") download(`${stem}.csv`, ["rank," + header, ...top.map((i: number, k: number) => `${k + 1},${row(i)}`)].join("\n") + "\n", "text/csv");
      if (b.dataset.dl === "all") download(`hub_all_scores.csv`, [header, ...order.map(row)].join("\n") + "\n", "text/csv");
      if (b.dataset.dl === "sif") download(`network.sif`, net.edges.map(([a, b2]: [string, string]) => `${a}\tpp\t${b2}`).join("\n") + "\n", "text/plain");
      if (b.dataset.dl === "attrs") download(`node_attributes.csv`, ["gene,hub_rank_" + algo + ",is_hub," + algorithms.join(","), ...order.map((i: number, k: number) => `${csvEsc(g.nodes[i])},${k + 1},${k < N ? 1 : 0},${algorithms.map((a) => scores[a][i]).join(",")}`)].join("\n") + "\n", "text/csv");
      if (b.dataset.dl === "png") { const a = document.createElement("a"); a.href = cy.png({ full: true, scale: 3, bg: "#ffffff" }); a.download = `${stem}.png`; a.click(); }
      flash(b, "Saved");
    }));
  </script>
  <script type="application/json" id="algo-help" set:html={JSON.stringify(algoHelp)} />
