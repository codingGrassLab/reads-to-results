---
// Root: send visitors to their language. Works without JS via the links and meta refresh.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reads to Results</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #fbfbf9; color: #15201f; font-family: system-ui, sans-serif; }
      nav { display: flex; gap: 1.5rem; font-size: 1.2rem; }
      a { color: #0f6e6a; }
    </style>
  </head>
  <body>
    <nav><a href="/en/">Reads to Results</a></nav>
  </body>
</html>
